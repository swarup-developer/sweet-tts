    const-string v2, "\u0986\u09b0\u0993 \u09ad\u09af\u09bc\u09c7\u09b8 \u09af\u09cb\u0997 \u0995\u09b0\u09be\u09b0 \u09b8\u09c1\u09ac\u09bf\u09a7\u09be: \u0985\u09cd\u09af\u09be\u09aa \u099b\u09cb\u099f \u09b0\u09be\u0996\u09a4\u09c7 Nathan, Daniel, Karen, Maged \u0993 Tarik \u098f\u0996\u09a8 \u0985\u09cd\u09af\u09be\u09aa\u09c7\u09b0 \u09ad\u09c7\u09a4\u09b0\u09c7 \u09a8\u09c7\u0987\u0964 \u098f\u0997\u09c1\u09b2\u09cb, \u09ac\u09be \u0985\u09a8\u09cd\u09af \u09af\u09c7\u0995\u09cb\u09a8\u09cb Vocalizer \u09ad\u09af\u09bc\u09c7\u09b8, \u0986\u09aa\u09a8\u09bf \u098f\u0995\u099f\u09bf \u09ab\u09cb\u09b2\u09cd\u09a1\u09be\u09b0 \u09a5\u09c7\u0995\u09c7 \u09af\u09cb\u0997 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964 Other Settings-\u098f\u09b0 \u09b8\u09ac\u099a\u09c7\u09af\u09bc\u09c7 \u0993\u09aa\u09b0\u09c7 More voices \u09ac\u09cb\u09a4\u09be\u09ae \u0986\u099b\u09c7, \u09a4\u09be\u09a4\u09c7 \u09a4\u09bf\u09a8\u099f\u09bf \u09a7\u09be\u09aa\u0964"

