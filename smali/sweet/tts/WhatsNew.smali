    .line 131
    const-string v2, "\u0910\u092a \u091b\u094b\u091f\u093e \u0939\u094b \u0917\u092f\u093e \u0939\u0948: \u0932\u0917\u092d\u0917 135 MB \u0915\u0940 \u091c\u0917\u0939 \u0905\u092c \u0932\u0917\u092d\u0917 77 MB\u0964"

    aput-object v2, v1, v5

    .line 132
    const-string v2, "\u0914\u0930 \u0906\u0935\u093e\u091c\u093c\u0947\u0902 \u091c\u094b\u0921\u093c\u0928\u0947 \u0915\u093e \u0935\u093f\u0915\u0932\u094d\u092a: \u0910\u092a \u091b\u094b\u091f\u093e \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f Nathan, Daniel, Karen, Maged \u0914\u0930 Tarik \u0905\u092c \u0910\u092a \u0915\u0947 \u0905\u0902\u0926\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902\u0964 \u0907\u0928\u094d\u0939\u0947\u0902, \u092f\u093e \u0915\u094b\u0908 \u092d\u0940 \u0914\u0930 Vocalizer \u0906\u0935\u093e\u091c\u093c, \u0906\u092a \u090f\u0915 \u092b\u094b\u0932\u094d\u0921\u0930 \u0938\u0947 \u091c\u094b\u0921\u093c \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 Other Settings \u092e\u0947\u0902 \u0938\u092c\u0938\u0947 \u090a\u092a\u0930 More voices \u092c\u091f\u0928 \u0939\u0948, \u0909\u0938\u0915\u0947 \u0924\u0940\u0928 \u091a\u0930\u0923 \u0939\u0948\u0902\u0964"

    aput-object v2, v1, v6

    .line 133
    const-string v2, "Backup \u0914\u0930 Restore: Import \u0914\u0930 Export \u0915\u093e \u0928\u093e\u092e \u092c\u0926\u0932\u0915\u0930 Backup Settings \u0914\u0930 Restore Settings \u0915\u0930 \u0926\u093f\u092f\u093e \u0939\u0948, \u0921\u093f\u0915\u094d\u0936\u0928\u0930\u0940 \u092e\u0947\u0902 \u092d\u0940\u0964"

    aput-object v2, v1, v7

    .line 134
    const-string v2, "\u092e\u0926\u0926 \u0915\u0940 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u092d\u093e\u0937\u093e\u090f\u0901: \u092c\u091f\u0928\u094b\u0902 \u0915\u0947 \u0928\u0940\u091a\u0947 \u0915\u0947 \u091b\u094b\u091f\u0947 \u0935\u093f\u0935\u0930\u0923 \u0905\u092c \u0939\u093f\u0902\u0926\u0940, \u092c\u0902\u0917\u0932\u093e, \u0909\u0930\u094d\u0926\u0942 \u092f\u093e \u0905\u0930\u092c\u0940 \u092e\u0947\u0902 \u0926\u0947\u0916\u0947 \u091c\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u090a\u092a\u0930 \u0938\u0947 \u092d\u093e\u0937\u093e \u091a\u0941\u0928\u093f\u090f, \u092f\u093e \u092c\u093e\u0926 \u092e\u0947\u0902 Other Settings \u092e\u0947\u0902 What\'s new and help language \u092c\u091f\u0928 \u0938\u0947\u0964"

