    const-string p0, "Plus \u092e\u0947\u0902 \u0928\u092f\u093e: IBM Eloquence \u0914\u0930 SpeechFlow \u0915\u094b \u0906\u0935\u093e\u091c\u093c \u0915\u0940 \u0924\u0930\u0939 \u091a\u0941\u0928\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948 (English \u092e\u0947\u0902 \u0926\u094b\u0928\u094b\u0902, Hindi \u0914\u0930 Urdu \u092e\u0947\u0902 SpeechFlow)\u0964 \u092f\u0947 \u0939\u0930 \u092d\u093e\u0937\u093e \u0915\u0940 \u0938\u0942\u091a\u0940 \u092e\u0947\u0902 \u0938\u092c\u0938\u0947 \u0906\u0916\u093c\u093f\u0930 \u092e\u0947\u0902 \u0926\u093f\u0916\u0924\u0947 \u0939\u0948\u0902\u0964 \u0907\u0928\u0915\u0947 \u0932\u093f\u090f \u0907\u0928\u0915\u0947 \u0905\u092a\u0928\u0947 \u0910\u092a \u092b\u094b\u0928 \u092e\u0947\u0902 \u0932\u0917\u0947 \u0939\u094b\u0928\u0947 \u091a\u093e\u0939\u093f\u090f, \u0928 \u0939\u094b\u0902 \u0924\u094b \u092d\u093e\u0937\u093e \u0915\u0940 \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0906\u0935\u093e\u091c\u093c \u092c\u094b\u0932\u0947\u0917\u0940\u0964 \u0907\u0928\u0915\u0947 \u0932\u093f\u090f \u0911\u0932 \u0907\u0928 \u0935\u0928 \u0915\u0940 Dictionary \u0914\u0930 Punctuation \u0938\u0947\u091f\u093f\u0902\u0917 \u0928\u0939\u0940\u0902 \u0932\u0917\u0924\u0940, \u0907\u0928\u0915\u0940 \u0905\u092a\u0928\u0940 \u0938\u0947\u091f\u093f\u0902\u0917 \u0915\u093e\u092e \u0915\u0930\u0924\u0940 \u0939\u0948\u0964"

