    const-string p0, "Plus-\u098f \u09a8\u09a4\u09c1\u09a8: IBM Eloquence \u0993 SpeechFlow \u09ad\u09af\u09bc\u09c7\u09b8 \u09b9\u09bf\u09b8\u09c7\u09ac\u09c7 \u09ac\u09c7\u099b\u09c7 \u09a8\u09c7\u0993\u09af\u09bc\u09be \u09af\u09be\u09af\u09bc (English-\u098f \u09a6\u09c1\u099f\u09cb\u0987, Hindi \u0993 Urdu-\u09a4\u09c7 SpeechFlow)\u0964 \u09aa\u09cd\u09b0\u09a4\u09bf\u099f\u09bf \u09ad\u09be\u09b7\u09be\u09b0 \u09a4\u09be\u09b2\u09bf\u0995\u09be\u09af\u09bc \u098f\u0997\u09c1\u09b2\u09cb \u098f\u0995\u09a6\u09ae \u09b6\u09c7\u09b7\u09c7 \u09a5\u09be\u0995\u09c7\u0964 \u098f\u0997\u09c1\u09b2\u09cb\u09b0 \u099c\u09a8\u09cd\u09af \u098f\u09a6\u09c7\u09b0 \u09a8\u09bf\u099c\u09b8\u09cd\u09ac \u0985\u09cd\u09af\u09be\u09aa \u09ab\u09cb\u09a8\u09c7 \u09b2\u09be\u0997\u09be\u09a8\u09cb \u09a5\u09be\u0995\u09a4\u09c7 \u09b9\u09ac\u09c7, \u09a8\u09be \u09a5\u09be\u0995\u09b2\u09c7 \u09ad\u09be\u09b7\u09be\u09b0 \u09b8\u09be\u09a7\u09be\u09b0\u09a3 \u09ad\u09af\u09bc\u09c7\u09b8 \u09aa\u09a1\u09bc\u09ac\u09c7\u0964 \u098f\u0997\u09c1\u09b2\u09cb\u09b0 \u099c\u09a8\u09cd\u09af \u0985\u09b2 \u0987\u09a8 \u0993\u09af\u09bc\u09be\u09a8\u09c7\u09b0 Dictionary \u0993 Punctuation \u09b8\u09c7\u099f\u09bf\u0982 \u0995\u09be\u099c \u0995\u09b0\u09c7 \u09a8\u09be, \u098f\u09a6\u09c7\u09b0 \u09a8\u09bf\u099c\u09c7\u09b0 \u09b8\u09c7\u099f\u09bf\u0982 \u0995\u09be\u099c \u0995\u09b0\u09c7\u0964"

