    const-string v2, "\u092c\u0948\u091f\u0930\u0940 \u0915\u0940 \u0916\u092a\u0924 \u092c\u0939\u0941\u0924 \u0915\u092e \u0939\u0941\u0908 \u0939\u0948\u0964 \u092a\u0922\u093c\u0924\u0947 \u0938\u092e\u092f \u0910\u092a \u0905\u092c \u092c\u0939\u0941\u0924 \u0915\u092e \u092c\u0948\u091f\u0930\u0940 \u0932\u0947\u0924\u093e \u0939\u0948\u0964"

