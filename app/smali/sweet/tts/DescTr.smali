    .line 113
    new-array v2, v1, [Ljava/lang/String;

    const-string v3, "\u0995\u09cb\u09a8\u09cb \u09b8\u09cd\u0995\u09cd\u09b0\u09bf\u09a8 \u09b0\u09bf\u09a1\u09be\u09b0 \u0985\u09b2 \u0987\u09a8 \u0993\u09af\u09bc\u09be\u09a8 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09be\u09b0 \u09b8\u09ae\u09af\u09bc \u098f\u0995\u099f\u09bf \u099b\u09cb\u099f \u09a8\u09cb\u099f\u09bf\u09ab\u09bf\u0995\u09c7\u09b6\u09a8 \u09a6\u09c7\u0996\u09bf\u09af\u09bc\u09c7 \u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf\u0995\u09c7 \u09ac\u09cd\u09af\u09be\u0995\u0997\u09cd\u09b0\u09be\u0989\u09a8\u09cd\u09a1\u09c7 \u099a\u09be\u09b2\u09c1 \u09b0\u09be\u0996\u09c7, \u09af\u09be\u09a4\u09c7 \u09ab\u09cb\u09a8 \u09b8\u09c7\u099f\u09bf \u09ac\u09a8\u09cd\u09a7 \u09a8\u09be \u0995\u09b0\u09c7\u0964 \u09ac\u09cd\u09af\u09be\u099f\u09be\u09b0\u09bf \u0996\u09b0\u099a \u09b9\u09af\u09bc \u09a8\u09be\u0964"

    aput-object v3, v2, v4

    .line 114
    const-string v3, "\u062c\u0628 \u06a9\u0648\u0626\u06cc \u0627\u0633\u06a9\u0631\u06cc\u0646 \u0631\u06cc\u0688\u0631 \u0622\u0644 \u0627\u0650\u0646 \u0648\u064e\u0646 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631 \u0631\u06c1\u0627 \u06c1\u0648\u060c \u062a\u0648 \u0627\u06cc\u06a9 \u0686\u06be\u0648\u0679\u0627 \u0646\u0648\u0679\u06cc\u0641\u06a9\u06cc\u0634\u0646 \u062f\u06a9\u06be\u0627 \u06a9\u0631 \u0627\u06cc\u067e \u06a9\u0648 \u0628\u06cc\u06a9 \u06af\u0631\u0627\u0624\u0646\u0688 \u0645\u06cc\u06ba \u0686\u0627\u0644\u0648 \u0631\u06a9\u06be\u062a\u0627 \u06c1\u06d2\u060c \u062a\u0627\u06a9\u06c1 \u0641\u0648\u0646 \u0627\u0633\u06d2 \u0628\u0646\u062f \u0646\u06c1 \u06a9\u0631\u06d2\u06d4 \u0628\u06cc\u0679\u0631\u06cc \u062e\u0631\u0686 \u0646\u06c1\u06cc\u06ba \u06c1\u0648\u062a\u06cc\u06d4"

    aput-object v3, v2, v5

    .line 115
    const-string v3, "\u0639\u0646\u062f\u0645\u0627 \u064a\u0633\u062a\u062e\u062f\u0645 \u0642\u0627\u0631\u0626 \u0627\u0644\u0634\u0627\u0634\u0629 \u062a\u0637\u0628\u064a\u0642 Sweet TTS\u060c \u064a\u064f\u0628\u0642\u064a\u0647 \u064a\u0639\u0645\u0644 \u0641\u064a \u0627\u0644\u062e\u0644\u0641\u064a\u0629 \u0645\u0639 \u0625\u0634\u0639\u0627\u0631 \u0635\u063a\u064a\u0631\u060c \u062d\u062a\u0649 \u0644\u0627 \u064a\u063a\u0644\u0642\u0647 \u0627\u0644\u0647\u0627\u062a\u0641. \u0644\u0627 \u064a\u0633\u062a\u0647\u0644\u0643 \u0627\u0644\u0628\u0637\u0627\u0631\u064a\u0629."

    aput-object v3, v2, v6

    .line 112
    const-string v3, "\u091c\u092c \u0915\u094b\u0908 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0930\u0940\u0921\u0930 \u0911\u0932 \u0907\u0928 \u0935\u0928 \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930 \u0930\u0939\u093e \u0939\u094b, \u0924\u092c \u090f\u0915 \u091b\u094b\u091f\u0940 \u0938\u0942\u091a\u0928\u093e \u0926\u093f\u0916\u093e\u0915\u0930 \u0910\u092a \u0915\u094b \u092c\u0948\u0915\u0917\u094d\u0930\u093e\u0909\u0902\u0921 \u092e\u0947\u0902 \u091a\u093e\u0932\u0942 \u0930\u0916\u0924\u093e \u0939\u0948, \u0924\u093e\u0915\u093f \u092b\u093c\u094b\u0928 \u0909\u0938\u0947 \u092c\u0902\u0926 \u0928 \u0915\u0930\u0947\u0964 \u092c\u0948\u091f\u0930\u0940 \u0928\u0939\u0940\u0902 \u0916\u093e\u0924\u093e\u0964"

    invoke-static {v3, v2}, Lkotlin/TuplesKt;->to(Ljava/lang/Object;Ljava/lang/Object;)Lkotlin/Pair;

