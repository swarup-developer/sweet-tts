    .line 14
    const-string v3, "\u0622\u0644 \u0627\u0650\u0646 \u0648\u0646 \u06a9\u0648 \u0679\u06be\u06cc\u06a9 \u0633\u06d2 \u0686\u0644\u0627\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 Google TTS \u06a9\u06cc \u06cc\u06c1 \u062a\u06cc\u0646 \u0633\u06cc\u0679\u0646\u06af\u06cc\u06ba \u06a9\u0631\u0646\u0627 \u0636\u0631\u0648\u0631\u06cc \u06c1\u06d2\u06d4"

