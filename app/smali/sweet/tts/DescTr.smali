    .line 74
    const-string v3, "\u0645\u0648\u0628\u0627\u0626\u0644 \u0646\u0645\u0628\u0631 \u06a9\u0646 \u0679\u06a9\u0691\u0648\u06ba \u0645\u06cc\u06ba \u067e\u0691\u06be\u0627 \u062c\u0627\u0626\u06d2\u060c \u0627\u0633 \u06a9\u0627 \u0627\u0646\u062a\u062e\u0627\u0628\u06d4 \u06c1\u0631 \u06c1\u0646\u062f\u0633\u06c1 \u0627\u0644\u06af \u0627\u0644\u06af \u067e\u0691\u06be\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627 \u0627\u0648\u0631 \u0679\u06a9\u0691\u0648\u06ba \u06a9\u06d2 \u062f\u0631\u0645\u06cc\u0627\u0646 \u0631\u06a9\u06d2 \u06af\u0627\u06d4 \u0627\u062e\u062a\u06cc\u0627\u0631\u0627\u062a \u06a9\u06d2 \u0646\u0627\u0645 \u0645\u06cc\u06ba \u062c\u0648 \u0679\u06a9\u0691\u06d2 \u0646\u0638\u0631 \u0622\u062a\u06d2 \u06c1\u06cc\u06ba \u0648\u06c1\u06cc \u0627\u0635\u0644 \u0645\u06cc\u06ba \u0628\u0646\u06cc\u06ba \u06af\u06d2\u06d4 \u0645\u062b\u0627\u0644: +91 98765 43210 \u06a9\u0648 5-5 \u0648\u0627\u0644\u06d2 \u0627\u062e\u062a\u06cc\u0627\u0631 \u0645\u06cc\u06ba \'9 1, 9 8 7 6 5, 4 3 2 1 0\' \u067e\u0691\u06be\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627\u06d4"

    aput-object v3, v2, v5

    .line 75
    const-string v3, "\u0627\u062e\u062a\u064a\u0627\u0631 \u062a\u0642\u0633\u064a\u0645 \u0631\u0642\u0645 \u0627\u0644\u062c\u0648\u0627\u0644 \u0625\u0644\u0649 \u0623\u062c\u0632\u0627\u0621 \u0639\u0646\u062f \u0627\u0644\u0642\u0631\u0627\u0621\u0629. \u064a\u064f\u0642\u0631\u0623 \u0643\u0644 \u0631\u0642\u0645 \u0639\u0644\u0649 \u062d\u062f\u0629 \u0645\u0639 \u062a\u0648\u0642\u0641 \u0628\u064a\u0646 \u0627\u0644\u0623\u062c\u0632\u0627\u0621. \u0627\u0644\u0623\u062c\u0632\u0627\u0621 \u0627\u0644\u0638\u0627\u0647\u0631\u0629 \u0641\u064a \u0627\u0633\u0645 \u0627\u0644\u062e\u064a\u0627\u0631 \u0647\u064a \u0627\u0644\u062a\u064a \u0633\u062a\u064f\u0633\u062a\u062e\u062f\u0645 \u0641\u0639\u0644\u0627\u064b. \u0645\u062b\u0627\u0644: +91 98765 43210 \u0628\u062e\u064a\u0627\u0631 5-5 \u064a\u064f\u0642\u0631\u0623 \'9 1, 9 8 7 6 5, 4 3 2 1 0\'."

    aput-object v3, v2, v6

    .line 72
    const-string v3, "\u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0915\u093f\u0928 \u091f\u0941\u0915\u0921\u093c\u094b\u0902 \u092e\u0947\u0902 \u092a\u0922\u093c\u093e \u091c\u093e\u090f, \u0907\u0938\u0915\u093e \u091a\u0941\u0928\u093e\u0935\u0964 \u0939\u0930 \u0905\u0902\u0915 \u0905\u0932\u0917-\u0905\u0932\u0917 \u092a\u0922\u093c\u093e \u091c\u093e\u090f\u0917\u093e \u0914\u0930 \u091f\u0941\u0915\u0921\u093c\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u0930\u0941\u0915\u0947\u0917\u093e\u0964 \u0935\u093f\u0915\u0932\u094d\u092a\u094b\u0902 \u0915\u0947 \u0928\u093e\u092e \u092e\u0947\u0902 \u0926\u093f\u0916\u0947 \u091f\u0941\u0915\u0921\u093c\u0947 \u0939\u0940 \u0905\u0938\u0932 \u092e\u0947\u0902 \u092c\u0928\u0947\u0902\u0917\u0947\u0964 \u0909\u0926\u093e\u0939\u0930\u0923: +91 98765 43210 \u0915\u094b 5-5 \u0935\u093e\u0932\u0947 \u0935\u093f\u0915\u0932\u094d\u092a \u092e\u0947\u0902 \'9 1, 9 8 7 6 5, 4 3 2 1 0\' \u092a\u0922\u093c\u093e \u091c\u093e\u090f\u0917\u093e\u0964"

    invoke-static {v3, v2}, Lkotlin/TuplesKt;->to(Ljava/lang/Object;Ljava/lang/Object;)Lkotlin/Pair;

