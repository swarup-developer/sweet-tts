    .line 98
    new-array v2, v1, [Ljava/lang/String;

    const-string v3, "\u0995\u09cb\u09a8\u09cb \u09b6\u09ac\u09cd\u09a6\u09c7\u09b0 \u099c\u09be\u09af\u09bc\u0997\u09be\u09af\u09bc \u0985\u09a8\u09cd\u09af \u09b6\u09ac\u09cd\u09a6 \u09ac\u09b2\u09be\u09a8\u09cb, \u09af\u09c7\u09ae\u09a8 \u09ad\u09c1\u09b2 \u0989\u099a\u09cd\u099a\u09be\u09b0\u09a3 \u09a0\u09bf\u0995 \u0995\u09b0\u09be\u0964 \u09b0\u09bf\u09aa\u09cd\u09b2\u09c7\u09b8\u09ae\u09c7\u09a8\u09cd\u099f \u0996\u09be\u09b2\u09bf \u09b0\u09be\u0996\u09b2\u09c7 \u09b8\u09c7\u0987 \u09b6\u09ac\u09cd\u09a6 \u0986\u09b0 \u09aa\u09a1\u09bc\u09be\u0987 \u09b9\u09ac\u09c7 \u09a8\u09be\u0964"

    aput-object v3, v2, v4

    .line 99
    const-string v3, "\u06a9\u0633\u06cc \u0644\u0641\u0638 \u06a9\u06cc \u062c\u06af\u06c1 \u062f\u0648\u0633\u0631\u0627 \u0644\u0641\u0638 \u0628\u0644\u0648\u0627\u0646\u0627\u060c \u062c\u06cc\u0633\u06d2 \u063a\u0644\u0637 \u062a\u0644\u0641\u0638 \u0679\u06be\u06cc\u06a9 \u06a9\u0631\u0646\u0627\u06d4 \u0631\u06cc\u067e\u0644\u06cc\u0633\u0645\u0646\u0679 \u062e\u0627\u0644\u06cc \u0686\u06be\u0648\u0691\u06cc\u06ba \u06af\u06d2 \u062a\u0648 \u0648\u06c1 \u0644\u0641\u0638 \u067e\u0691\u06be\u0627 \u06c1\u06cc \u0646\u06c1\u06cc\u06ba \u062c\u0627\u0626\u06d2 \u06af\u0627\u06d4"

    aput-object v3, v2, v5

    .line 100
    const-string v3, "\u064a\u0646\u0637\u0642 \u0643\u0644\u0645\u0629 \u0628\u062f\u0644\u0627\u064b \u0645\u0646 \u0623\u062e\u0631\u0649\u060c \u0645\u062b\u0644\u0627\u064b \u0644\u062a\u0635\u062d\u064a\u062d \u0646\u0637\u0642 \u062e\u0627\u0637\u0626. \u0625\u0630\u0627 \u062a\u0631\u0643\u062a \u0627\u0644\u0628\u062f\u064a\u0644 \u0641\u0627\u0631\u063a\u0627\u064b \u0641\u0644\u0646 \u062a\u064f\u0646\u0637\u0642 \u0627\u0644\u0643\u0644\u0645\u0629 \u0625\u0637\u0644\u0627\u0642\u0627\u064b."

    aput-object v3, v2, v6

    .line 97
    const-string v3, "\u0915\u093f\u0938\u0940 \u0936\u092c\u094d\u0926 \u0915\u0940 \u091c\u0917\u0939 \u0926\u0942\u0938\u0930\u093e \u0936\u092c\u094d\u0926 \u092c\u094b\u0932\u0935\u093e\u0928\u093e, \u091c\u0948\u0938\u0947 \u0917\u0932\u0924 \u0909\u091a\u094d\u091a\u093e\u0930\u0923 \u0920\u0940\u0915 \u0915\u0930\u0928\u093e\u0964 \u0930\u093f\u092a\u094d\u0932\u0947\u0938\u092e\u0947\u0902\u091f \u0916\u093e\u0932\u0940 \u091b\u094b\u0921\u093c\u0947\u0902\u0917\u0947 \u0924\u094b \u0935\u0939 \u0936\u092c\u094d\u0926 \u092c\u094b\u0932\u093e \u0939\u0940 \u0928\u0939\u0940\u0902 \u091c\u093e\u090f\u0917\u093e\u0964"

