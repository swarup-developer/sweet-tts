    .line 148
    new-array v2, v1, [Ljava/lang/String;

    const-string v3, "\u09aa\u09cd\u09b0\u09a5\u09ae\u09ac\u09be\u09b0 Usage Access-\u098f\u09b0 \u0985\u09a8\u09c1\u09ae\u09a4\u09bf \u09a6\u09bf\u09a4\u09c7 \u09b9\u09ac\u09c7, \u09af\u09be\u09a4\u09c7 \u0985\u09cd\u09af\u09be\u09aa \u099c\u09be\u09a8\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7 \u09b8\u09cd\u0995\u09cd\u09b0\u09bf\u09a8\u09c7 \u0995\u09cb\u09a8 \u0985\u09cd\u09af\u09be\u09aa \u0996\u09cb\u09b2\u09be \u0986\u099b\u09c7\u0964 \u098f\u0987 \u0985\u09a8\u09c1\u09ae\u09a4\u09bf App info-\u09b0 Permissions \u09a4\u09be\u09b2\u09bf\u0995\u09be\u09af\u09bc \u0986\u09b8\u09c7 \u09a8\u09be\u0964 \u098f\u099f\u09bf \u09ab\u09cb\u09a8\u09c7\u09b0 Settings-\u098f Special app access-\u098f\u09b0 \u09ad\u09c7\u09a4\u09b0\u09c7 Usage access-\u098f \u09aa\u09be\u0993\u09af\u09bc\u09be \u09af\u09be\u09af\u09bc\u0964 \u09b8\u09c7\u0996\u09be\u09a8\u09c7 \u09b8\u09c1\u0987\u099a \u099a\u09be\u09b2\u09c1 \u09a8\u09be \u09b9\u09b2\u09c7 \u098f\u09ac\u0982 \u09ab\u09cb\u09a8 restricted setting-\u098f\u09b0 \u09ac\u09be\u09b0\u09cd\u09a4\u09be \u09a6\u09c7\u0996\u09be\u09b2\u09c7, Settings-\u098f\u09b0 Apps-\u098f \u0997\u09bf\u09af\u09bc\u09c7 Sweet TTS \u0996\u09c1\u09b2\u09c7 App info-\u09a4\u09c7 \u09af\u09be\u09a8\u0964 \u0993\u09aa\u09b0\u09c7\u09b0 \u09a1\u09be\u09a8 \u0995\u09cb\u09a3\u09c7 More options (\u09a4\u09bf\u09a8\u099f\u09bf \u09ac\u09bf\u09a8\u09cd\u09a6\u09c1) \u099a\u09c7\u09aa\u09c7 Allow restricted settings \u09ac\u09c7\u099b\u09c7 \u09a8\u09bf\u09a8, \u09a4\u09be\u09b0\u09aa\u09b0 \u0986\u09ac\u09be\u09b0 \u0985\u09a8\u09c1\u09ae\u09a4\u09bf \u09a6\u09bf\u09a8\u0964"

    aput-object v3, v2, v4

    .line 149
    const-string v3, "\u067e\u06c1\u0644\u06cc \u0628\u0627\u0631 Usage Access \u06a9\u06cc \u0627\u062c\u0627\u0632\u062a \u062f\u06cc\u0646\u06cc \u06c1\u0648\u06af\u06cc\u060c \u062a\u0627\u06a9\u06c1 \u0627\u06cc\u067e \u062c\u0627\u0646 \u0633\u06a9\u06d2 \u06a9\u06c1 \u0627\u0633\u06a9\u0631\u06cc\u0646 \u067e\u0631 \u06a9\u0648\u0646 \u0633\u06cc \u0627\u06cc\u067e \u06a9\u06be\u0644\u06cc \u06c1\u06d2\u06d4 \u06cc\u06c1 \u0627\u062c\u0627\u0632\u062a App info \u06a9\u06cc Permissions \u0641\u06c1\u0631\u0633\u062a \u0645\u06cc\u06ba \u0646\u06c1\u06cc\u06ba \u0622\u062a\u06cc\u06d4 \u06cc\u06c1 \u0641\u0648\u0646 \u06a9\u06cc Settings \u0645\u06cc\u06ba Special app access \u06a9\u06d2 \u0627\u0646\u062f\u0631 Usage access \u0645\u06cc\u06ba \u0645\u0644\u062a\u06cc \u06c1\u06d2\u06d4 \u0627\u06af\u0631 \u0648\u06c1\u0627\u06ba \u0633\u0648\u0626\u0686 \u0622\u0646 \u0646\u06c1 \u06c1\u0648 \u0627\u0648\u0631 \u0641\u0648\u0646 restricted setting \u06a9\u0627 \u067e\u06cc\u063a\u0627\u0645 \u062f\u06a9\u06be\u0627\u0626\u06d2 \u062a\u0648 Settings \u0645\u06cc\u06ba Apps \u0645\u06cc\u06ba Sweet TTS \u06a9\u06be\u0648\u0644 \u06a9\u0631 App info \u0645\u06cc\u06ba \u062c\u0627\u0626\u06cc\u06ba\u06d4 \u0627\u0648\u067e\u0631 \u062f\u0627\u0626\u06cc\u06ba \u06a9\u0648\u0646\u06d2 \u0645\u06cc\u06ba More options (\u062a\u06cc\u0646 \u0646\u0642\u0637\u06d2) \u062f\u0628\u0627 \u06a9\u0631 Allow restricted settings \u0686\u0646\u06cc\u06ba\u060c \u067e\u06be\u0631 \u0627\u062c\u0627\u0632\u062a \u062f\u0648\u0628\u0627\u0631\u06c1 \u062f\u06cc\u06ba\u06d4"

    aput-object v3, v2, v5

    .line 150
    const-string v3, "\u0641\u064a \u0627\u0644\u0645\u0631\u0629 \u0627\u0644\u0623\u0648\u0644\u0649 \u0639\u0644\u064a\u0643 \u0645\u0646\u062d \u0625\u0630\u0646 Usage Access \u0644\u064a\u0639\u0631\u0641 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0623\u064a \u062a\u0637\u0628\u064a\u0642 \u0645\u0641\u062a\u0648\u062d \u0639\u0644\u0649 \u0627\u0644\u0634\u0627\u0634\u0629. \u0644\u0627 \u064a\u0638\u0647\u0631 \u0647\u0630\u0627 \u0627\u0644\u0625\u0630\u0646 \u0641\u064a \u0642\u0627\u0626\u0645\u0629 Permissions \u0636\u0645\u0646 App info\u060c \u0628\u0644 \u062a\u062c\u062f\u0647 \u0641\u064a Settings \u062f\u0627\u062e\u0644 Special app access \u062b\u0645 Usage access. \u0625\u0630\u0627 \u0644\u0645 \u064a\u0643\u0646 \u0627\u0644\u0645\u0641\u062a\u0627\u062d \u0647\u0646\u0627\u0643 \u0642\u0627\u0628\u0644\u0627\u064b \u0644\u0644\u062a\u0634\u063a\u064a\u0644 \u0648\u0623\u0638\u0647\u0631 \u0627\u0644\u0647\u0627\u062a\u0641 \u0631\u0633\u0627\u0644\u0629 restricted setting\u060c \u0641\u0641\u064a Settings \u0627\u0641\u062a\u062d Apps \u062b\u0645 Sweet TTS \u062b\u0645 App info. \u0627\u0636\u063a\u0637 More options (\u0627\u0644\u0646\u0642\u0627\u0637 \u0627\u0644\u062b\u0644\u0627\u062b) \u0641\u064a \u0623\u0639\u0644\u0649 \u0627\u0644\u064a\u0645\u064a\u0646 \u0648\u0627\u062e\u062a\u0631 Allow restricted settings\u060c \u062b\u0645 \u0627\u0645\u0646\u062d \u0627\u0644\u0625\u0630\u0646 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649."

    aput-object v3, v2, v6

    .line 147
    const-string v3, "\u092a\u0939\u0932\u0940 \u092c\u093e\u0930 Usage Access \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0928\u0940 \u0939\u094b\u0917\u0940, \u0924\u093e\u0915\u093f \u0910\u092a \u091c\u093e\u0928 \u0938\u0915\u0947 \u0915\u093f \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 \u0915\u094c\u0928 \u0938\u0940 \u0910\u092a \u0916\u0941\u0932\u0940 \u0939\u0948\u0964 \u092f\u0939 \u0905\u0928\u0941\u092e\u0924\u093f App info \u0915\u0940 Permissions \u0938\u0942\u091a\u0940 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u0906\u0924\u0940\u0964 \u092f\u0939 \u092b\u094b\u0928 \u0915\u0940 Settings \u092e\u0947\u0902 Special app access \u0915\u0947 \u0905\u0902\u0926\u0930 Usage access \u092e\u0947\u0902 \u092e\u093f\u0932\u0924\u0940 \u0939\u0948\u0964 \u0905\u0917\u0930 \u0935\u0939\u093e\u0901 \u0938\u094d\u0935\u093f\u091a \u0911\u0928 \u0928 \u0939\u094b \u0914\u0930 \u092b\u094b\u0928 restricted setting \u0915\u093e \u0938\u0902\u0926\u0947\u0936 \u0926\u093f\u0916\u093e\u090f, \u0924\u094b Settings \u092e\u0947\u0902 Apps \u092e\u0947\u0902 Sweet TTS \u0916\u094b\u0932\u0915\u0930 App info \u092e\u0947\u0902 \u091c\u093e\u0907\u090f\u0964 \u090a\u092a\u0930 \u0926\u093e\u090f\u0901 \u0915\u094b\u0928\u0947 \u092e\u0947\u0902 More options (\u0924\u0940\u0928 \u092c\u093f\u0902\u0926\u0941) \u0926\u092c\u093e\u0915\u0930 Allow restricted settings \u091a\u0941\u0928\u093f\u090f, \u092b\u093f\u0930 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u094b\u092c\u093e\u0930\u093e \u0926\u0940\u091c\u093f\u090f\u0964"

    invoke-static {v3, v2}, Lkotlin/TuplesKt;->to(Ljava/lang/Object;Ljava/lang/Object;)Lkotlin/Pair;

    move-result-object v2

    const/16 v3, 0x1b

    aput-object v2, v0, v3

    .line 153
    new-array v2, v1, [Ljava/lang/String;

    const-string v3, "\u09af\u09c7 \u0985\u09cd\u09af\u09be\u09aa\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09b2\u09be\u09a6\u09be \u09ad\u09af\u09bc\u09c7\u09b8 \u099a\u09be\u09a8, \u09b8\u09c7\u099f\u09bf \u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8\u0964 \u09af\u09cb\u0997 \u0995\u09b0\u09be \u0985\u09cd\u09af\u09be\u09aa \u09b8\u09b0\u09be\u09a4\u09c7 \u09a4\u09be\u09b0 \u09a8\u09be\u09ae\u09c7 \u09ac\u09c7\u09b6\u09bf\u0995\u09cd\u09b7\u09a3 \u099a\u09c7\u09aa\u09c7 \u09a7\u09b0\u09c1\u09a8 (long press)\u0964"

    aput-object v3, v2, v4

    .line 154
    const-string v3, "\u062c\u0633 \u0627\u06cc\u067e \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0644\u06af \u0622\u0648\u0627\u0632 \u0686\u0627\u06c1\u06cc\u06d2\u060c \u0627\u0633\u06d2 \u0634\u0627\u0645\u0644 \u06a9\u0631\u06cc\u06ba\u06d4 \u0634\u0627\u0645\u0644 \u06a9\u06cc \u06c1\u0648\u0626\u06cc \u0627\u06cc\u067e \u06a9\u0648 \u06c1\u0679\u0627\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0633 \u06a9\u06d2 \u0646\u0627\u0645 \u06a9\u0648 \u062f\u06cc\u0631 \u062a\u06a9 \u062f\u0628\u0627\u0626\u06cc\u06ba (long press)\u06d4"

    aput-object v3, v2, v5

    .line 155
    const-string v3, "\u0623\u0636\u0641 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0630\u064a \u062a\u0631\u064a\u062f \u0644\u0647 \u0635\u0648\u062a\u0627\u064b \u0645\u062e\u062a\u0644\u0641\u0627\u064b. \u0648\u0644\u0625\u0632\u0627\u0644\u0629 \u062a\u0637\u0628\u064a\u0642 \u0645\u0636\u0627\u0641 \u0627\u0636\u063a\u0637 \u0645\u0637\u0648\u0644\u0627\u064b \u0639\u0644\u0649 \u0627\u0633\u0645\u0647 (long press)."

    aput-object v3, v2, v6

    .line 152
    const-string v3, "\u091c\u093f\u0938 \u0910\u092a \u0915\u0947 \u0932\u093f\u090f \u0905\u0932\u0917 \u0906\u0935\u093e\u091c\u093c \u091a\u093e\u0939\u093f\u090f, \u0909\u0938\u0947 \u091c\u094b\u0921\u093c\u093f\u090f\u0964 \u091c\u094b\u0921\u093c\u0940 \u0939\u0941\u0908 \u0910\u092a \u0915\u094b \u0939\u091f\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0909\u0938\u0915\u0947 \u0928\u093e\u092e \u0915\u094b \u0926\u0947\u0930 \u0924\u0915 \u0926\u092c\u093e\u0907\u090f (long press)\u0964"

    invoke-static {v3, v2}, Lkotlin/TuplesKt;->to(Ljava/lang/Object;Ljava/lang/Object;)Lkotlin/Pair;

