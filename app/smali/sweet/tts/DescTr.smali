    .line 88
    new-array v2, v1, [Ljava/lang/String;

    const-string v3, "\u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09bf\u09a4 \u09b8\u09c7\u0995\u09c7\u09a8\u09cd\u09a1 \u09aa\u09b0\u09c7 OTP \u09a8\u09bf\u099c\u09c7 \u09a5\u09c7\u0995\u09c7\u0987 clipboard-\u098f \u0995\u09aa\u09bf \u09b9\u09af\u09bc\u09c7 \u09af\u09be\u09ac\u09c7, \u09af\u09be\u09a4\u09c7 \u0986\u09aa\u09a8\u09bf OTP \u09ac\u09b8\u09be\u09a8\u09cb\u09b0 \u099c\u09be\u09af\u09bc\u0997\u09be\u09af\u09bc \u0986\u09b0\u09be\u09ae\u09c7 paste \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964"

    aput-object v3, v2, v4

    .line 89
    const-string v3, "\u0686\u0646\u06d2 \u06c1\u0648\u0626\u06d2 \u0633\u06cc\u06a9\u0646\u0688 \u06a9\u06d2 \u0628\u0639\u062f OTP \u062e\u0648\u062f \u0628\u062e\u0648\u062f clipboard \u0645\u06cc\u06ba \u06a9\u0627\u067e\u06cc \u06c1\u0648 \u062c\u0627\u0626\u06d2 \u06af\u0627\u060c \u062a\u0627\u06a9\u06c1 \u0622\u067e \u0627\u0633\u06d2 OTP \u0628\u06be\u0631\u0646\u06d2 \u06a9\u06cc \u062c\u06af\u06c1 \u067e\u0631 \u0622\u0631\u0627\u0645 \u0633\u06d2 paste \u06a9\u0631 \u0633\u06a9\u06cc\u06ba\u06d4"

    aput-object v3, v2, v5

    .line 90
    const-string v3, "\u0628\u0639\u062f \u0627\u0644\u0645\u062f\u0629 \u0627\u0644\u0645\u062d\u062f\u062f\u0629 \u0628\u0627\u0644\u062b\u0648\u0627\u0646\u064a \u064a\u064f\u0646\u0633\u062e \u0627\u0644\u0640 OTP \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b \u0625\u0644\u0649 clipboard \u0644\u062a\u062a\u0645\u0643\u0646 \u0645\u0646 \u0644\u0635\u0642\u0647 \u0628\u0633\u0647\u0648\u0644\u0629 \u0641\u064a \u062e\u0627\u0646\u0629 \u0625\u062f\u062e\u0627\u0644 OTP."

    aput-object v3, v2, v6

    .line 87
    const-string v3, "\u091a\u0941\u0928\u0947 \u0939\u0941\u090f \u0938\u0947\u0915\u0902\u0921 \u0915\u0947 \u092c\u093e\u0926 OTP \u0905\u092a\u0928\u0947 \u0906\u092a clipboard \u092e\u0947\u0902 \u0915\u0949\u092a\u0940 \u0939\u094b \u091c\u093e\u090f\u0917\u093e, \u0924\u093e\u0915\u093f \u0906\u092a \u0909\u0938\u0947 OTP \u092d\u0930\u0928\u0947 \u0915\u0940 \u091c\u0917\u0939 \u092a\u0930 \u0906\u0930\u093e\u092e \u0938\u0947 paste \u0915\u0930 \u0938\u0915\u0947\u0902\u0964"

