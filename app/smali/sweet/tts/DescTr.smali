    .line 35
    const-string v3, "\u0627\u062e\u062a\u0631 \u0641\u0642\u0637 \u0627\u0644\u0644\u063a\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u062d\u062a\u0627\u062c\u0647\u0627 \u0648\u0627\u062a\u0631\u0643 \u0627\u0644\u0628\u0627\u0642\u064a \u0641\u0627\u0631\u063a\u0627\u064b. \u0643\u0644\u0645\u0627 \u0642\u0644\u0651 \u0639\u062f\u062f \u0627\u0644\u0644\u063a\u0627\u062a \u0643\u0627\u0646 \u0627\u0644\u062a\u0639\u0631\u0651\u0641 \u0639\u0644\u0649 \u0627\u0644\u0644\u063a\u0629 \u0623\u0633\u0631\u0639 \u0648\u0623\u062f\u0642."

