    .line 128
    new-array v2, v1, [Ljava/lang/String;

    const-string v3, "\u09ad\u09af\u09bc\u09c7\u09b8\u09c7\u09b0 \u09ad\u09b2\u09bf\u0989\u09ae, \u0997\u09a4\u09bf \u0993 \u09aa\u09bf\u099a \u098f\u0996\u09be\u09a8\u09c7 \u09ac\u09a6\u09b2\u09be\u09a8\u09cb \u09af\u09be\u09af\u09bc\u0964 \u09a6\u09b0\u0995\u09be\u09b0 \u09b9\u09b2\u09c7\u0987 \u09ac\u09a6\u09b2\u09be\u09a8\u0964 \u09b8\u09be\u09a7\u09be\u09b0\u09a3\u09a4 \u09ad\u09b2\u09bf\u0989\u09ae \u09ab\u09cb\u09a8\u09c7\u09b0 \u09b8\u09bf\u09b8\u09cd\u099f\u09c7\u09ae \u09ad\u09b2\u09bf\u0989\u09ae \u09a6\u09bf\u09af\u09bc\u09c7 \u09b0\u09be\u0996\u09c1\u09a8, \u0986\u09b0 \u0997\u09a4\u09bf \u0993 \u09aa\u09bf\u099a TalkBack \u09ac\u09be Jieshuo-\u09b0 \u09a8\u09bf\u099c\u09b8\u09cd\u09ac \u09b8\u09c7\u099f\u09bf\u0982 \u09a5\u09c7\u0995\u09c7\u0964 \u098f\u0996\u09be\u09a8\u0995\u09be\u09b0 \u09b8\u09c7\u099f\u09bf\u0982 \u0993\u0987 \u09b8\u09c7\u099f\u09bf\u0982\u09af\u09bc\u09c7\u09b0 \u09b8\u0999\u09cd\u0997\u09c7 \u09ae\u09bf\u09b2\u09c7 \u0995\u09be\u099c \u0995\u09b0\u09c7, \u09a4\u09be\u0987 \u09a6\u09c1\u0987 \u09ad\u09be\u09b7\u09be\u09b0 \u09ad\u09af\u09bc\u09c7\u09b8\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u09aa\u09b0\u09b8\u09cd\u09aa\u09b0 \u09aa\u09be\u09b0\u09cd\u09a5\u0995\u09cd\u09af \u09ae\u09a8\u09c7 \u09b9\u09b2\u09c7\u0987 \u09b6\u09c1\u09a7\u09c1 \u098f\u0996\u09be\u09a8\u09c7 \u09ac\u09a6\u09b2\u09be\u09a8\u0964"

    aput-object v3, v2, v4

    .line 129
    const-string v3, "\u0622\u0648\u0627\u0632 \u06a9\u06cc \u0628\u0644\u0646\u062f\u06cc\u060c \u0631\u0641\u062a\u0627\u0631 \u0627\u0648\u0631 \u067e\u0686 \u06cc\u06c1\u0627\u06ba \u0628\u062f\u0644\u06cc \u062c\u0627 \u0633\u06a9\u062a\u06cc \u06c1\u06d2\u06d4 \u0627\u0646\u06c1\u06cc\u06ba \u062a\u0628 \u06c1\u06cc \u0628\u062f\u0644\u06cc\u06ba \u062c\u0628 \u0636\u0631\u0648\u0631\u062a \u06c1\u0648\u06d4 \u0639\u0627\u0645 \u0637\u0648\u0631 \u067e\u0631 \u0648\u0627\u0644\u06cc\u0648\u0645 \u0641\u0648\u0646 \u06a9\u06d2 \u0633\u0633\u0679\u0645 \u0648\u0627\u0644\u06cc\u0648\u0645 \u0633\u06d2 \u0631\u06a9\u06be\u06cc\u06ba\u060c \u0627\u0648\u0631 \u0631\u0641\u062a\u0627\u0631 \u0648 \u067e\u0686 TalkBack \u06cc\u0627 Jieshuo \u06a9\u06cc \u0627\u067e\u0646\u06cc \u0633\u06cc\u0679\u0646\u06af \u0633\u06d2\u06d4 \u06cc\u06c1\u0627\u06ba \u06a9\u06cc \u0633\u06cc\u0679\u0646\u06af \u0627\u0646 \u06a9\u06cc \u0633\u06cc\u0679\u0646\u06af \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0645\u0644 \u06a9\u0631 \u0627\u062b\u0631 \u06a9\u0631\u062a\u06cc \u06c1\u06d2\u060c \u0627\u0633 \u0644\u06cc\u06d2 \u06cc\u06c1\u0627\u06ba \u062a\u0628\u062f\u06cc\u0644\u06cc \u062a\u0628 \u06c1\u06cc \u06a9\u0631\u06cc\u06ba \u062c\u0628 \u062f\u0648 \u0632\u0628\u0627\u0646\u0648\u06ba \u06a9\u06cc \u0622\u0648\u0627\u0632\u0648\u06ba \u0645\u06cc\u06ba \u0622\u067e\u0633 \u0645\u06cc\u06ba \u0641\u0631\u0642 \u0644\u06af\u06d2\u06d4"

    aput-object v3, v2, v5

    .line 130
    const-string v3, "\u064a\u0645\u0643\u0646\u0643 \u0647\u0646\u0627 \u062a\u063a\u064a\u064a\u0631 \u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0635\u0648\u062a \u0648\u0627\u0644\u0633\u0631\u0639\u0629 \u0648\u062f\u0631\u062c\u0629 \u0627\u0644\u0646\u0628\u0631\u0629 (pitch). \u063a\u064a\u0651\u0631\u0647\u0627 \u0641\u0642\u0637 \u0639\u0646\u062f \u0627\u0644\u062d\u0627\u062c\u0629. \u0639\u0627\u062f\u0629\u064b \u0627\u0636\u0628\u0637 \u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0635\u0648\u062a \u0645\u0646 \u0645\u0633\u062a\u0648\u0649 \u0635\u0648\u062a \u0627\u0644\u0646\u0638\u0627\u0645 \u0641\u064a \u0627\u0644\u0647\u0627\u062a\u0641\u060c \u0648\u0627\u0644\u0633\u0631\u0639\u0629 \u0648\u0627\u0644\u0646\u0628\u0631\u0629 \u0645\u0646 \u0625\u0639\u062f\u0627\u062f\u0627\u062a TalkBack \u0623\u0648 Jieshuo \u0646\u0641\u0633\u0647\u0627. \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0647\u0646\u0627 \u062a\u0639\u0645\u0644 \u0645\u0639 \u0625\u0639\u062f\u0627\u062f\u0627\u062a\u0647\u0645\u0627 \u0645\u0639\u0627\u064b\u060c \u0644\u0630\u0644\u0643 \u0644\u0627 \u062a\u063a\u064a\u0651\u0631 \u0647\u0646\u0627 \u0625\u0644\u0627 \u0625\u0630\u0627 \u0644\u0627\u062d\u0638\u062a \u0641\u0631\u0642\u0627\u064b \u0628\u064a\u0646 \u0623\u0635\u0648\u0627\u062a \u0644\u063a\u062a\u064a\u0646."

    aput-object v3, v2, v6

    .line 127
    const-string v3, "\u0906\u0935\u093e\u091c\u093c \u0915\u0940 \u0924\u0947\u091c\u093c\u0940, \u0930\u092b\u093c\u094d\u0924\u093e\u0930 \u0914\u0930 \u092a\u093f\u091a \u092f\u0939\u093e\u0901 \u092c\u0926\u0932\u0940 \u091c\u093e \u0938\u0915\u0924\u0940 \u0939\u0948\u0964 \u0907\u0928\u094d\u0939\u0947\u0902 \u0924\u092d\u0940 \u092c\u0926\u0932\u093f\u090f \u091c\u092c \u091c\u093c\u0930\u0942\u0930\u0924 \u0939\u094b\u0964 \u0906\u092e \u0924\u094c\u0930 \u092a\u0930 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092b\u094b\u0928 \u0915\u0940 \u0938\u093f\u0938\u094d\u091f\u092e \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0938\u0947 \u0930\u0916\u093f\u090f, \u0914\u0930 \u0930\u092b\u093c\u094d\u0924\u093e\u0930 \u0935 \u092a\u093f\u091a TalkBack \u092f\u093e Jieshuo \u0915\u0940 \u0905\u092a\u0928\u0940 \u0938\u0947\u091f\u093f\u0902\u0917 \u0938\u0947\u0964 \u092f\u0939\u093e\u0901 \u0915\u0940 \u0938\u0947\u091f\u093f\u0902\u0917 \u0909\u0928\u0915\u0940 \u0938\u0947\u091f\u093f\u0902\u0917 \u0915\u0947 \u0938\u093e\u0925 \u092e\u093f\u0932\u0915\u0930 \u0905\u0938\u0930 \u0915\u0930\u0924\u0940 \u0939\u0948, \u0907\u0938\u0932\u093f\u090f \u092f\u0939\u093e\u0901 \u092c\u0926\u0932\u093e\u0935 \u0924\u092d\u0940 \u0915\u0930\u0947\u0902 \u091c\u092c \u0926\u094b \u092d\u093e\u0937\u093e\u0913\u0902 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c\u094b\u0902 \u092e\u0947\u0902 \u0906\u092a\u0938 \u092e\u0947\u0902 \u092b\u0930\u094d\u0915 \u0932\u0917\u0947\u0964"

    invoke-static {v3, v2}, Lkotlin/TuplesKt;->to(Ljava/lang/Object;Ljava/lang/Object;)Lkotlin/Pair;

