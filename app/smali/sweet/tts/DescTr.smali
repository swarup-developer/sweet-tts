    .line 28
    new-array v2, v1, [Ljava/lang/String;

    const-string v3, "Google-\u098f\u09b0 \u09ad\u09af\u09bc\u09c7\u09b8 \u09a1\u09be\u0989\u09a8\u09b2\u09cb\u09a1 \u0995\u09b0\u09be\u09b0 \u09b8\u09cd\u0995\u09cd\u09b0\u09bf\u09a8 \u0996\u09c1\u09b2\u09ac\u09c7\u0964 \u09b6\u09c1\u09a7\u09c1 \u09af\u09c7 \u09ad\u09be\u09b7\u09be\u0997\u09c1\u09b2\u09cb \u0986\u09aa\u09a8\u09be\u09b0 \u09a6\u09b0\u0995\u09be\u09b0 \u09b8\u09c7\u0997\u09c1\u09b2\u09cb\u0987 \u09a1\u09be\u0989\u09a8\u09b2\u09cb\u09a1 \u0995\u09b0\u09c1\u09a8\u0964"

