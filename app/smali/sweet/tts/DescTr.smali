    .line 68
    new-array v2, v1, [Ljava/lang/String;

    const-string v3, "\u0993\u09aa\u09b0\u09c7\u09b0 \u09b8\u09c7\u099f\u09bf\u0982 \u0995\u09a4 \u0985\u0999\u09cd\u0995 \u09a5\u09c7\u0995\u09c7 \u09aa\u09cd\u09b0\u09af\u09cb\u099c\u09cd\u09af \u09b9\u09ac\u09c7\u0964 8 \u09ac\u09c7\u099b\u09c7 \u09a8\u09bf\u09b2\u09c7 \u09b6\u09c1\u09a7\u09c1 8 \u09ac\u09be \u09a4\u09be\u09b0 \u09ac\u09c7\u09b6\u09bf \u0985\u0999\u09cd\u0995\u09c7\u09b0 \u09b8\u0982\u0996\u09cd\u09af\u09be\u09af\u09bc \u09aa\u09cd\u09b0\u09af\u09cb\u099c\u09cd\u09af \u09b9\u09ac\u09c7, \u099b\u09cb\u099f \u09b8\u0982\u0996\u09cd\u09af\u09be \u09b8\u09be\u09a7\u09be\u09b0\u09a3\u09ad\u09be\u09ac\u09c7 \u09aa\u09a1\u09bc\u09be \u09b9\u09ac\u09c7\u0964 4 \u0985\u0999\u09cd\u0995\u09c7\u09b0 \u09b8\u0982\u0996\u09cd\u09af\u09be \u09aa\u09cd\u09b0\u09be\u09af\u09bc\u0987 \u09b8\u09be\u09b2 \u09b9\u09af\u09bc, \u09a4\u09be\u0987 \u09ac\u09bf\u0995\u09b2\u09cd\u09aa \u09b6\u09c1\u09b0\u09c1 \u09b9\u09af\u09bc 5 \u09a5\u09c7\u0995\u09c7\u0964"

    aput-object v3, v2, v4

    .line 69
    const-string v3, "\u0627\u0648\u067e\u0631 \u06a9\u06cc \u0633\u06cc\u0679\u0646\u06af \u06a9\u062a\u0646\u06d2 \u06c1\u0646\u062f\u0633\u0648\u06ba \u0633\u06d2 \u0644\u0627\u06af\u0648 \u06c1\u0648\u06d4 8 \u0686\u0646\u0646\u06d2 \u067e\u0631 \u0635\u0631\u0641 8 \u06cc\u0627 \u0632\u06cc\u0627\u062f\u06c1 \u06c1\u0646\u062f\u0633\u0648\u06ba \u06a9\u06d2 \u0639\u062f\u062f \u067e\u0631 \u0644\u0627\u06af\u0648 \u06c1\u0648\u06af\u06cc\u060c \u0686\u06be\u0648\u0679\u0627 \u0639\u062f\u062f \u0639\u0627\u0645 \u0637\u0648\u0631 \u067e\u0631 \u067e\u0691\u06be\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627\u06d4 4 \u06c1\u0646\u062f\u0633\u06d2 \u0627\u06a9\u062b\u0631 \u0633\u0627\u0644 \u06c1\u0648\u062a\u06d2 \u06c1\u06cc\u06ba\u060c \u0627\u0633 \u0644\u06cc\u06d2 \u0627\u0646\u062a\u062e\u0627\u0628 5 \u0633\u06d2 \u0634\u0631\u0648\u0639 \u06c1\u0648\u062a\u0627 \u06c1\u06d2\u06d4"

    aput-object v3, v2, v5

    .line 70
    const-string v3, "\u0645\u0646 \u0643\u0645 \u0631\u0642\u0645 \u062a\u064f\u0637\u0628\u064e\u0651\u0642 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0623\u0639\u0644\u0627\u0647. \u0639\u0646\u062f \u0627\u062e\u062a\u064a\u0627\u0631 8 \u062a\u064f\u0637\u0628\u064e\u0651\u0642 \u0641\u0642\u0637 \u0639\u0644\u0649 \u0627\u0644\u0623\u0639\u062f\u0627\u062f \u0627\u0644\u0645\u0643\u0648\u0651\u0646\u0629 \u0645\u0646 8 \u0623\u0631\u0642\u0627\u0645 \u0623\u0648 \u0623\u0643\u062b\u0631\u060c \u0648\u062a\u064f\u0642\u0631\u0623 \u0627\u0644\u0623\u0639\u062f\u0627\u062f \u0627\u0644\u0623\u0635\u063a\u0631 \u0628\u0634\u0643\u0644 \u0639\u0627\u062f\u064a. \u0627\u0644\u0623\u0639\u062f\u0627\u062f \u0645\u0646 4 \u0623\u0631\u0642\u0627\u0645 \u063a\u0627\u0644\u0628\u0627\u064b \u0633\u0646\u0648\u0627\u062a\u060c \u0644\u0630\u0644\u0643 \u064a\u0628\u062f\u0623 \u0627\u0644\u0627\u062e\u062a\u064a\u0627\u0631 \u0645\u0646 5."

    aput-object v3, v2, v6

    .line 67
    const-string v3, "\u090a\u092a\u0930 \u0915\u0940 \u0938\u0947\u091f\u093f\u0902\u0917 \u0915\u093f\u0924\u0928\u0947 \u0905\u0902\u0915\u094b\u0902 \u0938\u0947 \u0932\u0917\u0947\u0964 8 \u091a\u0941\u0928\u0928\u0947 \u092a\u0930 \u0938\u093f\u0930\u094d\u092b 8 \u092f\u093e \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0905\u0902\u0915\u094b\u0902 \u0915\u0940 \u0938\u0902\u0916\u094d\u092f\u093e \u092a\u0930 \u0932\u0917\u0947\u0917\u0940, \u091b\u094b\u091f\u0940 \u0938\u0902\u0916\u094d\u092f\u093e \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u092a\u0922\u093c\u0940 \u091c\u093e\u090f\u0917\u0940\u0964 4 \u0905\u0902\u0915 \u0905\u0915\u094d\u0938\u0930 \u0938\u093e\u0932 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902, \u0907\u0938\u0932\u093f\u090f \u091a\u0941\u0928\u093e\u0935 5 \u0938\u0947 \u0936\u0941\u0930\u0942 \u0939\u094b\u0924\u093e \u0939\u0948\u0964"

