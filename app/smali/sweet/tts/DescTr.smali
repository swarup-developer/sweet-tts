    .line 29
    const-string v3, "Google \u06a9\u06cc \u0622\u0648\u0627\u0632\u06cc\u06ba \u0688\u0627\u0624\u0646 \u0644\u0648\u0688 \u06a9\u0631\u0646\u06d2 \u06a9\u06cc \u0627\u0633\u06a9\u0631\u06cc\u0646 \u06a9\u06be\u0644\u06d2 \u06af\u06cc\u06d4 \u0635\u0631\u0641 \u0648\u06c1\u06cc \u0632\u0628\u0627\u0646\u06cc\u06ba \u0688\u0627\u0624\u0646 \u0644\u0648\u0688 \u06a9\u0631\u06cc\u06ba \u062c\u0648 \u0622\u067e \u06a9\u0648 \u0686\u0627\u06c1\u06cc\u06cc\u06ba\u06d4"

