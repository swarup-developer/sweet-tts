    .line 48
    new-array v2, v1, [Ljava/lang/String;

    const-string v3, "@ # % \u098f\u09ac\u0982 \u09ac\u09cd\u09b0\u09cd\u09af\u09be\u0995\u09c7\u099f\u09c7\u09b0 \u09ae\u09a4\u09cb \u099a\u09bf\u09b9\u09cd\u09a8 \u0995\u09a4\u099f\u09be \u09aa\u09a1\u09bc\u09be \u09b9\u09ac\u09c7\u0964 Engine decides: \u0995\u09cb\u09a8\u09cb \u09aa\u09cd\u09b0\u09b8\u09c7\u09b8\u09bf\u0982 \u09a8\u09af\u09bc, \u0995\u09c0 \u09aa\u09a1\u09bc\u09a4\u09c7 \u09b9\u09ac\u09c7 \u09ad\u09af\u09bc\u09c7\u09b8 \u09a8\u09bf\u099c\u09c7\u0987 \u09a0\u09bf\u0995 \u0995\u09b0\u09c7\u0964 None: \u0995\u09cb\u09a8\u09cb \u099a\u09bf\u09b9\u09cd\u09a8 \u09aa\u09a1\u09bc\u09be \u09b9\u09ac\u09c7 \u09a8\u09be, \u09b6\u09c1\u09a7\u09c1 % @ & + \u00b0 \u09b6\u09ac\u09cd\u09a6\u09c7 \u09aa\u09a1\u09bc\u09be \u09b9\u09ac\u09c7 \u098f\u09ac\u0982 \u09ac\u09bf\u09b0\u09a4\u09bf \u09a5\u09be\u0995\u09ac\u09c7\u0964 Some: \u0985\u09b2\u09cd\u09aa \u0995\u09bf\u099b\u09c1, Most: \u09ac\u09c7\u09b6\u09bf\u09b0\u09ad\u09be\u0997, All: \u09b8\u09ac\u0995\u09bf\u099b\u09c1\u0964"

    aput-object v3, v2, v4

    .line 49
    const-string v3, "@ # % \u0627\u0648\u0631 \u0628\u0631\u06cc\u06a9\u0679 \u062c\u06cc\u0633\u06d2 \u0646\u0634\u0627\u0646 \u06a9\u062a\u0646\u06d2 \u067e\u0691\u06be\u06d2 \u062c\u0627\u0626\u06cc\u06ba\u06d4 Engine decides: \u06a9\u0648\u0626\u06cc \u067e\u0631\u0648\u0633\u06cc\u0633\u0646\u06af \u0646\u06c1\u06cc\u06ba\u060c \u0622\u0648\u0627\u0632 \u062e\u0648\u062f \u0637\u06d2 \u06a9\u0631\u062a\u06cc \u06c1\u06d2 \u06a9\u06c1 \u06a9\u06cc\u0627 \u067e\u0691\u06be\u0646\u0627 \u06c1\u06d2\u06d4 None: \u06a9\u0648\u0626\u06cc \u0646\u0634\u0627\u0646 \u0646\u06c1\u06cc\u06ba \u067e\u0691\u06be\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627\u060c \u0635\u0631\u0641 % @ & + \u00b0 \u0627\u0644\u0641\u0627\u0638 \u0645\u06cc\u06ba \u067e\u0691\u06be\u06d2 \u062c\u0627\u0626\u06cc\u06ba \u06af\u06d2 \u0627\u0648\u0631 \u0648\u0642\u0641\u06c1 \u0628\u0631\u0642\u0631\u0627\u0631 \u0631\u06c1\u06d2 \u06af\u0627\u06d4 Some: \u062a\u06be\u0648\u0691\u06d2\u060c Most: \u0632\u06cc\u0627\u062f\u06c1 \u062a\u0631\u060c All: \u0633\u0628\u06d4"

    aput-object v3, v2, v5

    .line 50
    const-string v3, "\u0643\u0645 \u0645\u0646 \u0627\u0644\u0631\u0645\u0648\u0632 \u0645\u062b\u0644 @ # % \u0648\u0627\u0644\u0623\u0642\u0648\u0627\u0633 \u064a\u064f\u0646\u0637\u0642. Engine decides: \u0628\u0644\u0627 \u0623\u064a \u0645\u0639\u0627\u0644\u062c\u0629\u060c \u0648\u0627\u0644\u0635\u0648\u062a \u0646\u0641\u0633\u0647 \u064a\u0642\u0631\u0631 \u0645\u0627 \u064a\u064f\u0646\u0637\u0642. None: \u0644\u0627 \u064a\u064f\u0646\u0637\u0642 \u0623\u064a \u0631\u0645\u0632\u060c \u0648\u062a\u064f\u0642\u0631\u0623 \u0641\u0642\u0637 % @ & + \u00b0 \u0643\u0643\u0644\u0645\u0627\u062a \u0645\u0639 \u0628\u0642\u0627\u0621 \u0627\u0644\u062a\u0648\u0642\u0641. Some: \u0627\u0644\u0642\u0644\u064a\u0644\u060c Most: \u0627\u0644\u0623\u0643\u062b\u0631\u060c All: \u0627\u0644\u0643\u0644."

    aput-object v3, v2, v6

    .line 47
    const-string v3, "@ # % \u0914\u0930 \u092c\u094d\u0930\u0948\u0915\u0947\u091f \u091c\u0948\u0938\u0947 \u091a\u093f\u0939\u094d\u0928 \u0915\u093f\u0924\u0928\u0947 \u092c\u094b\u0932\u0947 \u091c\u093e\u090f\u0901\u0964 Engine decides: \u0915\u094b\u0908 \u092a\u094d\u0930\u094b\u0938\u0947\u0938\u093f\u0902\u0917 \u0928\u0939\u0940\u0902, \u0906\u0935\u093e\u091c\u093c \u0916\u0941\u0926 \u0924\u092f \u0915\u0930\u0924\u0940 \u0939\u0948 \u0915\u094d\u092f\u093e \u092c\u094b\u0932\u0928\u093e \u0939\u0948\u0964 None: \u0915\u094b\u0908 \u091a\u093f\u0939\u094d\u0928 \u0928\u0939\u0940\u0902 \u092c\u094b\u0932\u093e \u091c\u093e\u090f\u0917\u093e, \u0938\u093f\u0930\u094d\u092b % @ & + \u00b0 \u0936\u092c\u094d\u0926\u094b\u0902 \u092e\u0947\u0902 \u092a\u0922\u093c\u0947 \u091c\u093e\u090f\u0901\u0917\u0947 \u0914\u0930 \u0930\u0941\u0915\u093e\u0935\u091f \u092c\u0928\u0940 \u0930\u0939\u0947\u0917\u0940\u0964 Some: \u0925\u094b\u0921\u093c\u0947, Most: \u091c\u093c\u094d\u092f\u093e\u0926\u093e\u0924\u0930, All: \u0938\u092c\u0964"

    invoke-static {v3, v2}, Lkotlin/TuplesKt;->to(Ljava/lang/Object;Ljava/lang/Object;)Lkotlin/Pair;

