    .line 15
    const-string v3, "\u0644\u0643\u064a \u064a\u0639\u0645\u0644 Sweet TTS \u0628\u0634\u0643\u0644 \u0635\u062d\u064a\u062d\u060c \u0645\u0646 \u0627\u0644\u0636\u0631\u0648\u0631\u064a \u0636\u0628\u0637 \u0625\u0639\u062f\u0627\u062f\u0627\u062a Google TTS \u0627\u0644\u062b\u0644\u0627\u062b\u0629 \u0647\u0630\u0647."

