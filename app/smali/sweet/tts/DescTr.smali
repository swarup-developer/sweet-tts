    .line 54
    const-string v3, "\u0627\u06cc\u067e \u06a9\u0627 cache \u0635\u0627\u0641 \u06a9\u0631\u062a\u0627 \u06c1\u06d2 \u0627\u0648\u0631 \u062a\u0645\u0627\u0645 \u0622\u0648\u0627\u0632\u06cc\u06ba \u0627\u0648\u0631 \u0633\u06cc\u0679\u0646\u06af\u06cc\u06ba \u062a\u0627\u0632\u06c1 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u06d4 \u0622\u067e \u06a9\u06cc \u0633\u06cc\u0679\u0646\u06af\u06cc\u06ba \u0645\u0679\u062a\u06cc \u0646\u06c1\u06cc\u06ba\u06d4"

