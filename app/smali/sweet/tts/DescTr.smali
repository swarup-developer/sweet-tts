    const-string v3, "\u09aa\u09cd\u09b0\u09a4\u09bf\u099f\u09bf \u09a7\u09be\u09aa\u09c7\u09b0 \u09ae\u09bf\u09b2\u09bf\u09b8\u09c7\u0995\u09c7\u09a8\u09cd\u09a1\u09c7 \u09ac\u09bf\u09b8\u09cd\u09a4\u09be\u09b0\u09bf\u09a4 \u09b0\u09c7\u0995\u09b0\u09cd\u09a1\u0964 \u09b6\u09c1\u09a7\u09c1 \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be\u09b0 \u09b8\u09ae\u09af\u09bc \u099a\u09be\u09b2\u09c1 \u09b0\u09be\u0996\u09c1\u09a8\u0964"

    aput-object v3, v2, v4

    .line 124
    const-string v3, "\u06c1\u0631 \u0645\u0631\u062d\u0644\u06d2 \u06a9\u0627 \u0645\u0644\u06cc \u0633\u06cc\u06a9\u0646\u0688 \u0645\u06cc\u06ba \u062a\u0641\u0635\u06cc\u0644\u06cc \u0631\u06cc\u06a9\u0627\u0631\u0688\u06d4 \u0635\u0631\u0641 \u062c\u0627\u0646\u0686 \u06a9\u06d2 \u0648\u0642\u062a \u0686\u0627\u0644\u0648 \u0631\u06a9\u06be\u06cc\u06ba\u06d4"

    aput-object v3, v2, v5

    .line 125
    const-string v3, "\u0633\u062c\u0644 \u0645\u0641\u0635\u0651\u0644 \u0644\u0643\u0644 \u062e\u0637\u0648\u0629 \u0628\u0627\u0644\u0645\u064a\u0644\u064a \u062b\u0627\u0646\u064a\u0629. \u0634\u063a\u0651\u0644\u0647 \u0641\u0642\u0637 \u0648\u0642\u062a \u0627\u0644\u0641\u062d\u0635."

    aput-object v3, v2, v6

    .line 122
    const-string v3, "\u0939\u0930 \u091a\u0930\u0923 \u0915\u093e \u092e\u093f\u0932\u0940\u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u0935\u093f\u0938\u094d\u0924\u0943\u0924 \u0930\u093f\u0915\u0949\u0930\u094d\u0921\u0964 \u0938\u093f\u0930\u094d\u092b \u091c\u093e\u0901\u091a \u0915\u0947 \u0938\u092e\u092f \u091a\u093e\u0932\u0942 \u0930\u0916\u0947\u0902\u0964"

