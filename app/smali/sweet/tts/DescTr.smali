    .line 92
    const-string v3, "OTP \u0906\u0928\u0947 \u0915\u0947 \u0915\u093f\u0924\u0928\u0947 \u0938\u0947\u0915\u0902\u0921 \u092c\u093e\u0926 clipboard \u092e\u0947\u0902 \u0915\u0949\u092a\u0940 \u0939\u094b\u0964 \u0926\u0947\u0930 \u0930\u0916\u0928\u0947 \u0938\u0947 \'Copied\' \u0915\u0940 \u0918\u094b\u0937\u0923\u093e \u0938\u0902\u0926\u0947\u0936 \u092a\u0922\u093c\u0924\u0947 \u0938\u092e\u092f \u092c\u0940\u091a \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u0906\u0924\u0940\u0964"

