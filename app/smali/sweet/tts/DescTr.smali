    .line 93
    new-array v2, v1, [Ljava/lang/String;

    const-string v3, "OTP \u0986\u09b8\u09be\u09b0 \u0995\u09a4 \u09b8\u09c7\u0995\u09c7\u09a8\u09cd\u09a1 \u09aa\u09b0\u09c7 clipboard-\u098f \u0995\u09aa\u09bf \u09b9\u09ac\u09c7\u0964 \u09a6\u09c7\u09b0\u09bf \u09b0\u09be\u0996\u09b2\u09c7 \u09ac\u09be\u09b0\u09cd\u09a4\u09be \u09aa\u09a1\u09bc\u09be\u09b0 \u09b8\u09ae\u09af\u09bc \u09ae\u09be\u099d\u0996\u09be\u09a8\u09c7 \'Copied\' \u0998\u09cb\u09b7\u09a3\u09be \u0986\u09b8\u09c7 \u09a8\u09be\u0964"

    aput-object v3, v2, v4

    .line 94
    const-string v3, "OTP \u0622\u0646\u06d2 \u06a9\u06d2 \u06a9\u062a\u0646\u06d2 \u0633\u06cc\u06a9\u0646\u0688 \u0628\u0639\u062f clipboard \u0645\u06cc\u06ba \u06a9\u0627\u067e\u06cc \u06c1\u0648\u06d4 \u062f\u06cc\u0631 \u0631\u06a9\u06be\u0646\u06d2 \u0633\u06d2 \u067e\u06cc\u063a\u0627\u0645 \u067e\u0691\u06be\u062a\u06d2 \u0648\u0642\u062a \u0628\u06cc\u0686 \u0645\u06cc\u06ba \'Copied\' \u06a9\u0627 \u0627\u0639\u0644\u0627\u0646 \u0646\u06c1\u06cc\u06ba \u0622\u062a\u0627\u06d4"

    aput-object v3, v2, v5

    .line 95
    const-string v3, "\u0628\u0639\u062f \u0643\u0645 \u062b\u0627\u0646\u064a\u0629 \u0645\u0646 \u0648\u0635\u0648\u0644 OTP \u064a\u064f\u0646\u0633\u062e \u0625\u0644\u0649 clipboard. \u0627\u0644\u062a\u0623\u062e\u064a\u0631 \u064a\u0645\u0646\u0639 \u0645\u0642\u0627\u0637\u0639\u0629 \u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0631\u0633\u0627\u0644\u0629 \u0628\u0625\u0639\u0644\u0627\u0646 \'Copied\'."

