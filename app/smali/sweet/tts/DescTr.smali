    new-array v2, v1, [Ljava/lang/String;

    const-string v3, "\u0985\u09cd\u09af\u09be\u09aa\u09c7\u09b0 \u0995\u09be\u099c\u0995\u09b0\u09cd\u09ae\u09c7\u09b0 \u098f\u0995\u099f\u09bf \u099b\u09cb\u099f \u09b0\u09c7\u0995\u09b0\u09cd\u09a1 \u09b0\u09be\u0996\u09c7, \u0997\u09cb\u09b2\u09ae\u09be\u09b2 \u0996\u09c1\u0981\u099c\u09c7 \u09a6\u09c7\u0996\u09be\u09b0 \u099c\u09a8\u09cd\u09af\u0964"

