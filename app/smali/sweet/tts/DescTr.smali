    .line 143
    new-array v2, v1, [Ljava/lang/String;

    const-string v3, "\u098f\u0987 \u09ad\u09af\u09bc\u09c7\u09b8\u09c7\u09b0 \u09ad\u09b2\u09bf\u0989\u09ae, \u0997\u09a4\u09bf \u0993 \u09aa\u09bf\u099a\u0964 Play Sample \u09a6\u09bf\u09af\u09bc\u09c7 \u09b6\u09c1\u09a8\u09c7 \u09a6\u09c7\u0996\u09c1\u09a8\u0964 -1% \u0993 +1% \u09ac\u09cb\u09a4\u09be\u09ae \u09a6\u09bf\u09af\u09bc\u09c7 \u09b8\u09c2\u0995\u09cd\u09b7\u09cd\u09ae \u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09a8 \u0995\u09b0\u09c1\u09a8\u0964"

