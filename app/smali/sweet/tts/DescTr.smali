    new-array v2, v1, [Ljava/lang/String;

    const-string v3, "App Info \u09b8\u09cd\u0995\u09cd\u09b0\u09bf\u09a8 \u0996\u09c1\u09b2\u09ac\u09c7\u0964 \u09b8\u09c7\u0996\u09be\u09a8\u09c7 Clear data \u09ac\u09cb\u09a4\u09be\u09ae\u099f\u09bf \u0996\u09c1\u0981\u099c\u09c7 \u09a1\u09c7\u099f\u09be \u09ae\u09c1\u099b\u09c7 \u09a6\u09bf\u09a8\u0964 \u0985\u09cd\u09af\u09be\u09aa \u09aa\u09cd\u09b0\u09a5\u09ae\u09ac\u09be\u09b0 \u09b8\u09c7\u099f \u0995\u09b0\u09be\u09b0 \u09b8\u09ae\u09af\u09bc \u098f\u099f\u09bf \u098f\u0995\u09ac\u09be\u09b0 \u0995\u09b0\u09be \u099c\u09b0\u09c1\u09b0\u09bf\u0964 \u09aa\u09b0\u09c7\u0993 Google TTS \u0986\u099f\u0995\u09c7 \u0997\u09c7\u09b2\u09c7 \u09ac\u09be \u0997\u09cb\u09b2\u09ae\u09be\u09b2 \u0995\u09b0\u09b2\u09c7 \u0986\u09ac\u09be\u09b0 \u0995\u09b0\u09a4\u09c7 \u09b9\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964"

    aput-object v3, v2, v4

    .line 19
    const-string v3, "App Info \u06a9\u06cc \u0627\u0633\u06a9\u0631\u06cc\u0646 \u06a9\u06be\u0644\u06d2 \u06af\u06cc\u06d4 \u0648\u06c1\u0627\u06ba Clear data \u0628\u0679\u0646 \u0688\u06be\u0648\u0646\u0688 \u06a9\u0631 \u0688\u06cc\u0679\u0627 \u0635\u0627\u0641 \u06a9\u0631\u06cc\u06ba\u06d4 \u0627\u06cc\u067e \u06a9\u06cc \u067e\u06c1\u0644\u06cc \u0633\u06cc\u0679\u0646\u06af \u06a9\u06d2 \u0648\u0642\u062a \u06cc\u06c1 \u0627\u06cc\u06a9 \u0628\u0627\u0631 \u06a9\u0631\u0646\u0627 \u0636\u0631\u0648\u0631\u06cc \u06c1\u06d2\u06d4 \u0628\u0639\u062f \u0645\u06cc\u06ba \u0628\u06be\u06cc \u062c\u0628 Google TTS \u0627\u0679\u06a9\u06d2 \u06cc\u0627 \u062e\u0631\u0627\u0628\u06cc \u06a9\u0631\u06d2 \u062a\u0648 \u062f\u0648\u0628\u0627\u0631\u06c1 \u06a9\u0631\u0646\u0627 \u067e\u0691 \u0633\u06a9\u062a\u0627 \u06c1\u06d2\u06d4"

    aput-object v3, v2, v5

    .line 20
    const-string v3, "\u0633\u062a\u0641\u062a\u062d \u0634\u0627\u0634\u0629 App Info. \u0627\u0628\u062d\u062b \u0647\u0646\u0627\u0643 \u0639\u0646 \u0632\u0631 Clear data \u0648\u0627\u0645\u0633\u062d \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a. \u0647\u0630\u0627 \u0636\u0631\u0648\u0631\u064a \u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629 \u0639\u0646\u062f \u0627\u0644\u0625\u0639\u062f\u0627\u062f \u0627\u0644\u0623\u0648\u0644 \u0644\u0644\u062a\u0637\u0628\u064a\u0642. \u0648\u0642\u062f \u062a\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u062a\u0643\u0631\u0627\u0631\u0647 \u0644\u0627\u062d\u0642\u0627\u064b \u0625\u0630\u0627 \u062a\u0648\u0642\u0641 Google TTS \u0623\u0648 \u0623\u0635\u0628\u062d \u0628\u0647 \u062e\u0644\u0644."

    aput-object v3, v2, v6

    .line 17
    const-string v3, "App Info \u0915\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0916\u0941\u0932\u0947\u0917\u0940\u0964 \u0935\u0939\u093e\u0901 Clear data \u092c\u091f\u0928 \u0922\u0942\u0901\u0922\u0915\u0930 \u0921\u0947\u091f\u093e \u0938\u093e\u092b\u093c \u0915\u0940\u091c\u093f\u090f\u0964 \u0910\u092a \u0915\u0940 \u092a\u0939\u0932\u0940 \u0938\u0947\u091f\u093f\u0902\u0917 \u0915\u0947 \u0938\u092e\u092f \u092f\u0939 \u090f\u0915 \u092c\u093e\u0930 \u0915\u0930\u0928\u093e \u091c\u093c\u0930\u0942\u0930\u0940 \u0939\u0948\u0964 \u092c\u093e\u0926 \u092e\u0947\u0902 \u092d\u0940 \u091c\u092c Google TTS \u0905\u091f\u0915\u0947 \u092f\u093e \u0917\u0921\u093c\u092c\u0921\u093c \u0915\u0930\u0947, \u0924\u094b \u0926\u094b\u092c\u093e\u0930\u093e \u0915\u0930\u0928\u093e \u092a\u0921\u093c \u0938\u0915\u0924\u093e \u0939\u0948\u0964"

    invoke-static {v3, v2}, Lkotlin/TuplesKt;->to(Ljava/lang/Object;Ljava/lang/Object;)Lkotlin/Pair;

    move-result-object v2

    aput-object v2, v0, v5

    .line 23
    new-array v2, v1, [Ljava/lang/String;

    const-string v3, "Google TTS-\u098f\u09b0 \u09b8\u09c7\u099f\u09bf\u0982 \u0996\u09c1\u09b2\u09ac\u09c7\u0964 \u09b8\u09c7\u0996\u09be\u09a8\u09c7 Language detection-\u098f \u09a4\u09bf\u09a8\u099f\u09bf \u09ac\u09bf\u0995\u09b2\u09cd\u09aa \u0986\u099b\u09c7, \u09a4\u09be\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 Off \u09ac\u09c7\u099b\u09c7 \u09a8\u09bf\u09a8\u0964 \u0985\u09cd\u09af\u09be\u09aa \u09a0\u09bf\u0995\u09ae\u09a4\u09cb \u0995\u09be\u099c \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u098f\u099f\u09bf \u099c\u09b0\u09c1\u09b0\u09bf\u0964"

    aput-object v3, v2, v4

    .line 24
    const-string v3, "Google TTS \u06a9\u06cc \u0633\u06cc\u0679\u0646\u06af \u06a9\u06be\u0644\u06d2 \u06af\u06cc\u06d4 \u0648\u06c1\u0627\u06ba Language detection \u0645\u06cc\u06ba \u062a\u06cc\u0646 \u0627\u062e\u062a\u06cc\u0627\u0631\u0627\u062a \u06c1\u06cc\u06ba\u060c \u0627\u0646 \u0645\u06cc\u06ba \u0633\u06d2 Off \u0686\u0646 \u0644\u06cc\u06ba\u06d4 \u0627\u06cc\u067e \u06a9\u06d2 \u0679\u06be\u06cc\u06a9 \u0633\u06d2 \u06a9\u0627\u0645 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u06cc\u06c1 \u0636\u0631\u0648\u0631\u06cc \u06c1\u06d2\u06d4"

    aput-object v3, v2, v5

    .line 25
    const-string v3, "\u0633\u062a\u0641\u062a\u062d \u0625\u0639\u062f\u0627\u062f\u0627\u062a Google TTS. \u0641\u064a Language detection \u062b\u0644\u0627\u062b\u0629 \u062e\u064a\u0627\u0631\u0627\u062a\u060c \u0627\u062e\u062a\u0631 \u0645\u0646\u0647\u0627 Off. \u0647\u0630\u0627 \u0636\u0631\u0648\u0631\u064a \u0644\u0639\u0645\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0628\u0634\u0643\u0644 \u0635\u062d\u064a\u062d."

    aput-object v3, v2, v6

    .line 22
    const-string v3, "Google TTS \u0915\u0940 \u0938\u0947\u091f\u093f\u0902\u0917 \u0916\u0941\u0932\u0947\u0917\u0940\u0964 \u0935\u0939\u093e\u0901 Language detection \u092e\u0947\u0902 \u0924\u0940\u0928 \u0935\u093f\u0915\u0932\u094d\u092a \u0906\u0924\u0947 \u0939\u0948\u0902, \u0909\u0928\u092e\u0947\u0902 \u0938\u0947 Off \u091a\u0941\u0928 \u0932\u0940\u091c\u093f\u090f\u0964 \u0910\u092a \u0915\u0947 \u0920\u0940\u0915 \u0938\u0947 \u0915\u093e\u092e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092f\u0939 \u091c\u093c\u0930\u0942\u0930\u0940 \u0939\u0948\u0964"

