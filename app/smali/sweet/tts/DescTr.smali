    .line 80
    const-string v3, "\u0641\u064a \u0627\u0644\u0623\u0635\u0648\u0627\u062a \u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629 \u062a\u064f\u0642\u0631\u0623 \u0627\u0644\u0645\u0628\u0627\u0644\u063a \u0645\u0646 6 \u0625\u0644\u0649 9 \u0623\u0631\u0642\u0627\u0645 \u0628\u0648\u062d\u062f\u0627\u062a Lakh/Crore \u0628\u062f\u0644\u0627\u064b \u0645\u0646 Million/Billion."

