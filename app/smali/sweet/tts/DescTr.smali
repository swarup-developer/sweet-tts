    .line 43
    new-array v2, v1, [Ljava/lang/String;

    const-string v3, "\u0986\u09b2\u09be\u09a6\u09be \u0986\u09b2\u09be\u09a6\u09be \u0985\u09cd\u09af\u09be\u09aa\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09b2\u09be\u09a6\u09be \u09ad\u09af\u09bc\u09c7\u09b8 \u09ac\u09c7\u099b\u09c7 \u09a8\u09bf\u09a8, \u09af\u09c7\u09ae\u09a8 WhatsApp-\u098f\u09b0 \u098f\u0995\u099f\u09bf \u0986\u09b0 YouTube-\u098f\u09b0 \u0986\u09b0\u09c7\u0995\u099f\u09bf\u0964 \u098f\u09b0 \u099c\u09a8\u09cd\u09af Usage Access-\u098f\u09b0 \u0985\u09a8\u09c1\u09ae\u09a4\u09bf \u09b2\u09be\u0997\u09ac\u09c7\u0964"

    aput-object v3, v2, v4

    .line 44
    const-string v3, "\u0627\u0644\u06af \u0627\u0644\u06af \u0627\u06cc\u067e \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0644\u06af \u0622\u0648\u0627\u0632 \u0686\u0646\u06cc\u06ba\u060c \u062c\u06cc\u0633\u06d2 WhatsApp \u06a9\u06cc \u0627\u0644\u06af \u0627\u0648\u0631 YouTube \u06a9\u06cc \u0627\u0644\u06af\u06d4 \u0627\u0633 \u06a9\u06d2 \u0644\u06cc\u06d2 Usage Access \u06a9\u06cc \u0627\u062c\u0627\u0632\u062a \u0686\u0627\u06c1\u06cc\u06d2\u06d4"

    aput-object v3, v2, v5

    .line 45
    const-string v3, "\u0627\u062e\u062a\u0631 \u0635\u0648\u062a\u0627\u064b \u0645\u062e\u062a\u0644\u0641\u0627\u064b \u0644\u0643\u0644 \u062a\u0637\u0628\u064a\u0642\u060c \u0645\u062b\u0644\u0627\u064b \u0635\u0648\u062a \u0644\u0640 WhatsApp \u0648\u0622\u062e\u0631 \u0644\u0640 YouTube. \u064a\u062a\u0637\u0644\u0628 \u0630\u0644\u0643 \u0625\u0630\u0646 Usage Access."

    aput-object v3, v2, v6

    .line 42
    const-string v3, "\u0905\u0932\u0917-\u0905\u0932\u0917 \u0910\u092a \u0915\u0947 \u0932\u093f\u090f \u0905\u0932\u0917 \u0906\u0935\u093e\u091c\u093c \u091a\u0941\u0928\u093f\u090f, \u091c\u0948\u0938\u0947 WhatsApp \u0915\u0940 \u0905\u0932\u0917 \u0914\u0930 YouTube \u0915\u0940 \u0905\u0932\u0917\u0964 \u0907\u0938\u0915\u0947 \u0932\u093f\u090f Usage Access \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u091a\u093e\u0939\u093f\u090f\u0964"

