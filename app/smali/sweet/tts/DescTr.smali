    .line 119
    const-string v3, "\u0627\u06cc\u067e \u06a9\u06cc \u0633\u0631\u06af\u0631\u0645\u06cc \u06a9\u0627 \u0645\u062e\u062a\u0635\u0631 \u0631\u06cc\u06a9\u0627\u0631\u0688 \u0631\u06a9\u06be\u062a\u0627 \u06c1\u06d2\u060c \u062e\u0631\u0627\u0628\u06cc \u062c\u0627\u0646\u0686\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2\u06d4"

