    .line 30
    const-string v3, "\u0633\u062a\u0641\u062a\u062d \u0634\u0627\u0634\u0629 \u062a\u0646\u0632\u064a\u0644 \u0623\u0635\u0648\u0627\u062a Google. \u0646\u0632\u0651\u0644 \u0641\u0642\u0637 \u0627\u0644\u0644\u063a\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u062d\u062a\u0627\u062c\u0647\u0627."

