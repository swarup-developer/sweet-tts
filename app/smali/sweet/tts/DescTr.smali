    const-string v3, "\u0985\u09b2 \u0987\u09a8 \u0993\u09af\u09bc\u09be\u09a8 \u09a0\u09bf\u0995\u09ae\u09a4\u09cb \u099a\u09be\u09b2\u09be\u09a4\u09c7 Google TTS-\u098f\u09b0 \u098f\u0987 \u09a4\u09bf\u09a8\u099f\u09bf \u09b8\u09c7\u099f\u09bf\u0982 \u0995\u09b0\u09be \u099c\u09b0\u09c1\u09b0\u09bf\u0964"

