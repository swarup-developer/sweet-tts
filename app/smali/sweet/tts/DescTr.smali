    .line 103
    new-array v2, v1, [Ljava/lang/String;

    const-string v3, "\u09aa\u09c1\u09b0\u09cb \u09ac\u09be\u09b0\u09cd\u09a4\u09be \u098f\u0995\u0987 \u09ad\u09af\u09bc\u09c7\u09b8\u09c7 \u09aa\u09a1\u09bc\u09be \u09b9\u09ac\u09c7\u0964 \u09af\u09c7 \u09ad\u09be\u09b7\u09be\u09b0 \u09b6\u09ac\u09cd\u09a6 \u09b8\u09ac\u099a\u09c7\u09af\u09bc\u09c7 \u09ac\u09c7\u09b6\u09bf, \u09b8\u09c7\u0987 \u09ad\u09be\u09b7\u09be\u09b0 \u09ad\u09af\u09bc\u09c7\u09b8 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u09b9\u09ac\u09c7\u0964"

    aput-object v3, v2, v4

    .line 104
    const-string v3, "\u067e\u0648\u0631\u0627 \u067e\u06cc\u063a\u0627\u0645 \u0627\u06cc\u06a9 \u06c1\u06cc \u0622\u0648\u0627\u0632 \u0645\u06cc\u06ba \u067e\u0691\u06be\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627\u06d4 \u062c\u0633 \u0632\u0628\u0627\u0646 \u06a9\u06d2 \u0627\u0644\u0641\u0627\u0638 \u0633\u0628 \u0633\u06d2 \u0632\u06cc\u0627\u062f\u06c1 \u06c1\u0648\u06ba\u060c \u0627\u0633\u06cc \u06a9\u06cc \u0622\u0648\u0627\u0632 \u0644\u06af\u06d2 \u06af\u06cc\u06d4"

