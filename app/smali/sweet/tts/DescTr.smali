    .line 108
    new-array v2, v1, [Ljava/lang/String;

    const-string v3, "\u09b2\u09ae\u09cd\u09ac\u09be \u09ac\u09be\u09b0\u09cd\u09a4\u09be\u09b0 \u09aa\u09cd\u09b0\u09a5\u09ae \u09ac\u09be\u0995\u09cd\u09af \u09b8\u0999\u09cd\u0997\u09c7 \u09b8\u0999\u09cd\u0997\u09c7 \u09aa\u09a1\u09bc\u09be \u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09c7, \u09ac\u09be\u0995\u09bf \u0985\u0982\u09b6\u09c7\u09b0 \u09ad\u09be\u09b7\u09be \u09aa\u09c7\u099b\u09a8\u09c7 \u099a\u09bf\u09a8\u09c7 \u09a8\u09c7\u0993\u09af\u09bc\u09be \u09b9\u09af\u09bc\u0964"

    aput-object v3, v2, v4

    .line 109
    const-string v3, "\u0644\u0645\u0628\u06d2 \u067e\u06cc\u063a\u0627\u0645 \u06a9\u0627 \u067e\u06c1\u0644\u0627 \u062c\u0645\u0644\u06c1 \u0641\u0648\u0631\u0627\u064b \u0628\u0648\u0644\u0646\u0627 \u0634\u0631\u0648\u0639 \u06a9\u0631 \u062f\u06cc\u062a\u0627 \u06c1\u06d2\u060c \u0628\u0627\u0642\u06cc \u062d\u0635\u06d2 \u06a9\u06cc \u0632\u0628\u0627\u0646 \u067e\u06cc\u0686\u06be\u06d2 \u0633\u06d2 \u067e\u06c1\u0686\u0627\u0646\u06cc \u062c\u0627\u062a\u06cc \u06c1\u06d2\u06d4"

    aput-object v3, v2, v5

    .line 110
    const-string v3, "\u064a\u0628\u062f\u0623 \u0646\u0637\u0642 \u0627\u0644\u062c\u0645\u0644\u0629 \u0627\u0644\u0623\u0648\u0644\u0649 \u0645\u0646 \u0627\u0644\u0631\u0633\u0627\u0644\u0629 \u0627\u0644\u0637\u0648\u064a\u0644\u0629 \u0641\u0648\u0631\u0627\u064b\u060c \u0648\u064a\u062c\u0631\u064a \u0627\u0644\u062a\u0639\u0631\u0651\u0641 \u0639\u0644\u0649 \u0644\u063a\u0629 \u0628\u0642\u064a\u0629 \u0627\u0644\u0631\u0633\u0627\u0644\u0629 \u0641\u064a \u0627\u0644\u062e\u0644\u0641\u064a\u0629."

    aput-object v3, v2, v6

    .line 107
    const-string v3, "\u0932\u0902\u092c\u0947 \u0938\u0902\u0926\u0947\u0936 \u0915\u093e \u092a\u0939\u0932\u093e \u0935\u093e\u0915\u094d\u092f \u0924\u0941\u0930\u0902\u0924 \u092c\u094b\u0932\u0928\u093e \u0936\u0941\u0930\u0942 \u0915\u0930\u0924\u093e \u0939\u0948, \u092c\u093e\u0915\u0940 \u0939\u093f\u0938\u094d\u0938\u0947 \u0915\u0940 \u092d\u093e\u0937\u093e \u092a\u0940\u091b\u0947 \u0938\u0947 \u092a\u0939\u091a\u093e\u0928\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964"

