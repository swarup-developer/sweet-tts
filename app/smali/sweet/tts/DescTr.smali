    .line 34
    const-string v3, "\u0635\u0631\u0641 \u0648\u06c1\u06cc \u0632\u0628\u0627\u0646\u06cc\u06ba \u0686\u0646\u06cc\u06ba \u062c\u0648 \u0622\u067e \u06a9\u0648 \u0686\u0627\u06c1\u06cc\u06cc\u06ba\u060c \u0628\u0627\u0642\u06cc \u062e\u0627\u0644\u06cc \u0631\u06a9\u06be\u06cc\u06ba\u06d4 \u062c\u062a\u0646\u06cc \u06a9\u0645 \u0632\u0628\u0627\u0646\u06cc\u06ba\u060c \u0627\u062a\u0646\u06cc \u062a\u06cc\u0632 \u0627\u0648\u0631 \u062f\u0631\u0633\u062a \u067e\u06c1\u0686\u0627\u0646\u06d4"

