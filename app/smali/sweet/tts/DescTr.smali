    .line 83
    new-array v2, v1, [Ljava/lang/String;

    const-string v3, "\u09ac\u09be\u09b0\u09cd\u09a4\u09be\u09af\u09bc OTP \u09aa\u09c7\u09b2\u09c7 \u09b8\u09c7\u099f\u09bf \u0985\u0999\u09cd\u0995\u09c7 \u0985\u0999\u09cd\u0995\u09c7 \u09a5\u09c7\u09ae\u09c7 \u09a5\u09c7\u09ae\u09c7 \u09aa\u09a1\u09bc\u09ac\u09c7\u0964 OTP \u09aa\u09a1\u09bc\u09be\u09b0 \u09aa\u09b0 40 \u09b8\u09c7\u0995\u09c7\u09a8\u09cd\u09a1 \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4 \u0986\u09aa\u09a8\u09bf \u09ab\u09cb\u09a8 \u099d\u09be\u0981\u0995\u09be\u09b2\u09c7 \u09aa\u09cd\u09b0\u09a4\u09bf\u09ac\u09be\u09b0 \u099d\u09be\u0981\u0995\u09c1\u09a8\u09bf\u09a4\u09c7 \u09b8\u09c7\u0987 OTP \u0986\u09ac\u09be\u09b0 \u09b6\u09cb\u09a8\u09be\u09ac\u09c7\u0964 \u09a8\u09a4\u09c1\u09a8 OTP \u098f\u09b2\u09c7\u0987 40 \u09b8\u09c7\u0995\u09c7\u09a8\u09cd\u09a1 \u0986\u09ac\u09be\u09b0 \u09a8\u09a4\u09c1\u09a8 \u0995\u09b0\u09c7 \u09b6\u09c1\u09b0\u09c1 \u09b9\u09af\u09bc\u0964"

    aput-object v3, v2, v4

    .line 84
    const-string v3, "\u067e\u06cc\u063a\u0627\u0645 \u0645\u06cc\u06ba OTP \u0645\u0644\u06d2 \u062a\u0648 \u0627\u0633\u06d2 \u06c1\u0646\u062f\u0633\u06c1 \u06c1\u0646\u062f\u0633\u06c1 \u06a9\u0631 \u06a9\u06d2 \u0631\u06a9 \u0631\u06a9 \u06a9\u0631 \u067e\u0691\u06be\u06d2 \u06af\u0627\u06d4 OTP \u067e\u0691\u06be\u0646\u06d2 \u06a9\u06d2 \u0628\u0639\u062f 40 \u0633\u06cc\u06a9\u0646\u0688 \u062a\u06a9 \u0622\u067e \u0641\u0648\u0646 \u06a9\u0648 \u06c1\u0644\u0627\u0626\u06cc\u06ba \u06af\u06d2 \u062a\u0648 \u06c1\u0631 \u0628\u0627\u0631 \u06c1\u0644\u0627\u0646\u06d2 \u067e\u0631 \u0648\u06c1 OTP \u062f\u0648\u0628\u0627\u0631\u06c1 \u0633\u0646\u0627\u0626\u06d2 \u06af\u0627\u06d4 \u0646\u06cc\u0627 OTP \u0622\u062a\u06d2 \u06c1\u06cc 40 \u0633\u06cc\u06a9\u0646\u0688 \u062f\u0648\u0628\u0627\u0631\u06c1 \u0634\u0631\u0648\u0639 \u06c1\u0648 \u062c\u0627\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4"

    aput-object v3, v2, v5

    .line 85
    const-string v3, "\u0625\u0630\u0627 \u0648\u064f\u062c\u062f OTP \u0641\u064a \u0627\u0644\u0631\u0633\u0627\u0644\u0629 \u064a\u0642\u0631\u0623\u0647 \u0631\u0642\u0645\u0627\u064b \u0631\u0642\u0645\u0627\u064b \u0645\u0639 \u062a\u0648\u0642\u0641 \u0628\u064a\u0646 \u0627\u0644\u0623\u0631\u0642\u0627\u0645. \u0648\u0628\u0639\u062f \u0642\u0631\u0627\u0621\u062a\u0647\u060c \u0648\u0644\u0645\u062f\u0629 40 \u062b\u0627\u0646\u064a\u0629\u060c \u0643\u0644\u0645\u0627 \u0647\u0632\u0632\u062a \u0627\u0644\u0647\u0627\u062a\u0641 \u0623\u0639\u0627\u062f \u0642\u0631\u0627\u0621\u0629 \u0647\u0630\u0627 \u0627\u0644\u0640 OTP. \u0648\u0639\u0646\u062f \u0648\u0635\u0648\u0644 OTP \u062c\u062f\u064a\u062f \u062a\u0628\u062f\u0623 \u0627\u0644\u0640 40 \u062b\u0627\u0646\u064a\u0629 \u0645\u0646 \u062c\u062f\u064a\u062f."

    aput-object v3, v2, v6

    .line 82
    const-string v3, "\u0938\u0902\u0926\u0947\u0936 \u092e\u0947\u0902 OTP \u092e\u093f\u0932\u0947 \u0924\u094b \u0909\u0938\u0947 \u0905\u0902\u0915-\u0905\u0902\u0915 \u0915\u0930\u0915\u0947 \u0930\u0941\u0915-\u0930\u0941\u0915\u0915\u0930 \u092a\u0922\u093c\u0947\u0917\u093e\u0964 OTP \u092a\u0922\u093c\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 40 \u0938\u0947\u0915\u0902\u0921 \u0924\u0915 \u0906\u092a \u092b\u094b\u0928 \u0915\u094b \u0936\u0947\u0915 \u0915\u0930\u0947\u0902\u0917\u0947, \u0924\u094b \u0939\u0930 \u0936\u0947\u0915 \u092a\u0930 \u0935\u0939 OTP \u092b\u093f\u0930 \u0938\u0947 \u0938\u0941\u0928\u093e\u090f\u0917\u093e\u0964 \u0928\u092f\u093e OTP \u0906\u0924\u0947 \u0939\u0940 40 \u0938\u0947\u0915\u0902\u0921 \u092b\u093f\u0930 \u0938\u0947 \u0936\u0941\u0930\u0942 \u0939\u094b \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964"

    invoke-static {v3, v2}, Lkotlin/TuplesKt;->to(Ljava/lang/Object;Ljava/lang/Object;)Lkotlin/Pair;

