    .line 163
    new-array v2, v1, [Ljava/lang/String;

    const-string v3, "\u098f\u0987 \u0985\u09cd\u09af\u09be\u09aa\u09c7 \u09aa\u09cd\u09b0\u09a4\u09bf\u099f\u09bf \u09ad\u09be\u09b7\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09b2\u09be\u09a6\u09be \u09ad\u09af\u09bc\u09c7\u09b8 \u09ac\u09c7\u099b\u09c7 \u09a8\u09bf\u09a8\u0964 Same as global default \u09ae\u09be\u09a8\u09c7 \u0985\u09a8\u09cd\u09af \u099c\u09be\u09af\u09bc\u0997\u09be\u09af\u09bc \u09af\u09c7 \u09ad\u09af\u09bc\u09c7\u09b8, \u098f\u0996\u09be\u09a8\u09c7\u0993 \u09b8\u09c7\u099f\u09bf\u0987 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u09b9\u09ac\u09c7\u0964"

    aput-object v3, v2, v4

    .line 164
    const-string v3, "\u0627\u0633 \u0627\u06cc\u067e \u0645\u06cc\u06ba \u06c1\u0631 \u0632\u0628\u0627\u0646 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0644\u06af \u0622\u0648\u0627\u0632 \u0686\u0646\u06cc\u06ba\u06d4 Same as global default \u06a9\u0627 \u0645\u0637\u0644\u0628 \u06c1\u06d2 \u06a9\u06c1 \u0628\u0627\u0642\u06cc \u062c\u06af\u06c1 \u0648\u0627\u0644\u06cc \u0622\u0648\u0627\u0632 \u06c1\u06cc \u0644\u06af\u06d2 \u06af\u06cc\u06d4"

    aput-object v3, v2, v5

    .line 165
    const-string v3, "\u0627\u062e\u062a\u0631 \u0635\u0648\u062a\u0627\u064b \u0644\u0643\u0644 \u0644\u063a\u0629 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642. \u0627\u0644\u062e\u064a\u0627\u0631 Same as global default \u064a\u0639\u0646\u064a \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0645\u0639\u062a\u0645\u062f \u0641\u064a \u0628\u0642\u064a\u0629 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u0627\u062a."

    aput-object v3, v2, v6

    .line 162
    const-string v3, "\u0907\u0938 \u0910\u092a \u092e\u0947\u0902 \u0939\u0930 \u092d\u093e\u0937\u093e \u0915\u0947 \u0932\u093f\u090f \u0905\u0932\u0917 \u0906\u0935\u093e\u091c\u093c \u091a\u0941\u0928\u093f\u090f\u0964 Same as global default \u0915\u093e \u092e\u0924\u0932\u092c \u0939\u0948 \u0915\u093f \u092c\u093e\u0915\u0940 \u091c\u0917\u0939 \u0935\u093e\u0932\u0940 \u0906\u0935\u093e\u091c\u093c \u0939\u0940 \u0932\u0917\u0947\u0917\u0940\u0964"

    invoke-static {v3, v2}, Lkotlin/TuplesKt;->to(Ljava/lang/Object;Ljava/lang/Object;)Lkotlin/Pair;

