    .line 178
    new-array v2, v1, [Ljava/lang/String;

    const-string v3, "Add Entry \u09a6\u09bf\u09af\u09bc\u09c7 \u09a8\u09a4\u09c1\u09a8 \u098f\u09a8\u09cd\u099f\u09cd\u09b0\u09bf \u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8: \u0995\u09cb\u09a8 \u09b6\u09ac\u09cd\u09a6 \u0986\u09b0 \u09a4\u09be\u09b0 \u099c\u09be\u09af\u09bc\u0997\u09be\u09af\u09bc \u0995\u09c0 \u09ac\u09b2\u09a4\u09c7 \u09b9\u09ac\u09c7\u0964 \u09b0\u09bf\u09aa\u09cd\u09b2\u09c7\u09b8\u09ae\u09c7\u09a8\u09cd\u099f \u0996\u09be\u09b2\u09bf \u09b0\u09be\u0996\u09b2\u09c7 \u09b8\u09c7\u0987 \u09b6\u09ac\u09cd\u09a6 \u0986\u09b0 \u09aa\u09a1\u09bc\u09be\u0987 \u09b9\u09ac\u09c7 \u09a8\u09be\u0964 \u09af\u09c7\u09ae\u09a8 Maybe \u0986\u0997\u09c7 \u09a5\u09c7\u0995\u09c7\u0987 \u0996\u09be\u09b2\u09bf \u09b0\u09bf\u09aa\u09cd\u09b2\u09c7\u09b8\u09ae\u09c7\u09a8\u09cd\u099f\u09c7\u09b0 \u09b8\u0999\u09cd\u0997\u09c7 \u09af\u09cb\u0997 \u0995\u09b0\u09be \u0986\u099b\u09c7, \u09a4\u09be\u0987 WhatsApp \u099a\u09cd\u09af\u09be\u099f\u09c7 \u098f\u0987 \u09b2\u09c7\u09ac\u09c7\u09b2\u099f\u09bf \u09b6\u09cb\u09a8\u09be \u09af\u09be\u09af\u09bc \u09a8\u09be\u0964"

    aput-object v3, v2, v4

    .line 179
    const-string v3, "Add Entry \u0633\u06d2 \u0646\u06cc\u0627 \u0627\u0646\u062f\u0631\u0627\u062c \u0634\u0627\u0645\u0644 \u06a9\u0631\u06cc\u06ba: \u06a9\u0648\u0646 \u0633\u0627 \u0644\u0641\u0638 \u0627\u0648\u0631 \u0627\u0633 \u06a9\u06cc \u062c\u06af\u06c1 \u06a9\u06cc\u0627 \u0628\u0648\u0644\u0646\u0627 \u06c1\u06d2\u06d4 \u0631\u06cc\u067e\u0644\u06cc\u0633\u0645\u0646\u0679 \u062e\u0627\u0644\u06cc \u0686\u06be\u0648\u0691\u06cc\u06ba \u06af\u06d2 \u062a\u0648 \u0648\u06c1 \u0644\u0641\u0638 \u067e\u0691\u06be\u0627 \u06c1\u06cc \u0646\u06c1\u06cc\u06ba \u062c\u0627\u0626\u06d2 \u06af\u0627\u06d4 \u062c\u06cc\u0633\u06d2 Maybe \u067e\u06c1\u0644\u06d2 \u0633\u06d2 \u062e\u0627\u0644\u06cc \u0631\u06cc\u067e\u0644\u06cc\u0633\u0645\u0646\u0679 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u062c\u0691\u0627 \u06c1\u06d2\u060c \u0627\u0633 \u0644\u06cc\u06d2 WhatsApp \u06a9\u06cc \u0686\u06cc\u0679 \u0645\u06cc\u06ba \u06cc\u06c1 \u0644\u06cc\u0628\u0644 \u0633\u0646\u0627\u0626\u06cc \u0646\u06c1\u06cc\u06ba \u062f\u06cc\u062a\u0627\u06d4"

    aput-object v3, v2, v5

    .line 180
    const-string v3, "\u0627\u0633\u062a\u062e\u062f\u0645 Add Entry \u0644\u0625\u0636\u0627\u0641\u0629 \u0625\u062f\u062e\u0627\u0644 \u062c\u062f\u064a\u062f: \u0623\u064a \u0643\u0644\u0645\u0629 \u0648\u0645\u0627\u0630\u0627 \u064a\u064f\u0646\u0637\u0642 \u0628\u062f\u0644\u0627\u064b \u0645\u0646\u0647\u0627. \u0625\u0630\u0627 \u062a\u0631\u0643\u062a \u0627\u0644\u0628\u062f\u064a\u0644 \u0641\u0627\u0631\u063a\u0627\u064b \u0641\u0644\u0646 \u062a\u064f\u0646\u0637\u0642 \u0627\u0644\u0643\u0644\u0645\u0629 \u0625\u0637\u0644\u0627\u0642\u0627\u064b. \u0645\u062b\u0644\u0627\u064b \u0627\u0644\u0643\u0644\u0645\u0629 Maybe \u0645\u0636\u0627\u0641\u0629 \u0645\u0633\u0628\u0642\u0627\u064b \u0628\u0628\u062f\u064a\u0644 \u0641\u0627\u0631\u063a\u060c \u0648\u0644\u0630\u0644\u0643 \u0644\u0627 \u062a\u064f\u0633\u0645\u0639 \u0647\u0630\u0647 \u0627\u0644\u062a\u0633\u0645\u064a\u0629 \u0641\u064a \u0645\u062d\u0627\u062f\u062b\u0627\u062a WhatsApp."

    aput-object v3, v2, v6

    .line 177
    const-string v3, "Add Entry \u0938\u0947 \u0928\u0908 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f\u093f \u091c\u094b\u0921\u093c\u093f\u090f: \u0915\u094c\u0928 \u0938\u093e \u0936\u092c\u094d\u0926 \u0914\u0930 \u0909\u0938\u0915\u0940 \u091c\u0917\u0939 \u0915\u094d\u092f\u093e \u092c\u094b\u0932\u0928\u093e \u0939\u0948\u0964 \u0930\u093f\u092a\u094d\u0932\u0947\u0938\u092e\u0947\u0902\u091f \u0916\u093e\u0932\u0940 \u091b\u094b\u0921\u093c\u0947\u0902\u0917\u0947 \u0924\u094b \u0935\u0939 \u0936\u092c\u094d\u0926 \u092c\u094b\u0932\u093e \u0939\u0940 \u0928\u0939\u0940\u0902 \u091c\u093e\u090f\u0917\u093e\u0964 \u091c\u0948\u0938\u0947 Maybe \u092a\u0939\u0932\u0947 \u0938\u0947 \u0916\u093e\u0932\u0940 \u0930\u093f\u092a\u094d\u0932\u0947\u0938\u092e\u0947\u0902\u091f \u0915\u0947 \u0938\u093e\u0925 \u091c\u0941\u0921\u093c\u093e \u0939\u0948, \u0907\u0938\u0932\u093f\u090f WhatsApp \u0915\u0940 \u091a\u0948\u091f \u092e\u0947\u0902 \u092f\u0939 \u0932\u0947\u092c\u0932 \u0938\u0941\u0928\u093e\u0908 \u0928\u0939\u0940\u0902 \u0926\u0947\u0924\u093e\u0964"

