    .line 144
    const-string v3, "\u0627\u0633 \u0622\u0648\u0627\u0632 \u06a9\u0627 \u0648\u0627\u0644\u06cc\u0648\u0645\u060c \u0631\u0641\u062a\u0627\u0631 \u0627\u0648\u0631 \u067e\u0686\u06d4 Play Sample \u0633\u06d2 \u0633\u0646 \u06a9\u0631 \u062c\u0627\u0646\u0686\u06cc\u06ba\u06d4 -1% \u0627\u0648\u0631 +1% \u0628\u0679\u0646 \u0633\u06d2 \u0628\u0627\u0631\u06cc\u06a9 \u062a\u0628\u062f\u06cc\u0644\u06cc \u06a9\u0631\u06cc\u06ba\u06d4"

    aput-object v3, v2, v5

    .line 145
    const-string v3, "\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0635\u0648\u062a \u0648\u0627\u0644\u0633\u0631\u0639\u0629 \u0648\u0627\u0644\u0646\u0628\u0631\u0629 \u0644\u0647\u0630\u0627 \u0627\u0644\u0635\u0648\u062a. \u0627\u0633\u062a\u0645\u0639 \u0628\u0632\u0631 Play Sample \u0644\u0644\u062a\u062d\u0642\u0642. \u0627\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0632\u0631\u064a\u0646 -1% \u0648 +1% \u0644\u062a\u0639\u062f\u064a\u0644 \u062f\u0642\u064a\u0642."

    aput-object v3, v2, v6

    .line 142
    const-string v3, "\u0907\u0938 \u0906\u0935\u093e\u091c\u093c \u0915\u093e \u0935\u0949\u0932\u094d\u092f\u0942\u092e, \u0930\u092b\u093c\u094d\u0924\u093e\u0930 \u0914\u0930 \u092a\u093f\u091a\u0964 Play Sample \u0938\u0947 \u0938\u0941\u0928\u0915\u0930 \u091c\u093e\u0901\u091a\u093f\u090f\u0964 -1% \u0914\u0930 +1% \u092c\u091f\u0928 \u0938\u0947 \u092c\u093e\u0930\u0940\u0915 \u092c\u0926\u0932\u093e\u0935 \u0915\u0940\u091c\u093f\u090f\u0964"

