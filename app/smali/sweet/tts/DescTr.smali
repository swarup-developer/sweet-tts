    .line 63
    new-array v2, v1, [Ljava/lang/String;

    const-string v3, "\u09ac\u09a1\u09bc \u09b8\u0982\u0996\u09cd\u09af\u09be \u0995\u09c0\u09ad\u09be\u09ac\u09c7 \u09aa\u09a1\u09bc\u09be \u09b9\u09ac\u09c7\u0964 None: \u09af\u09c7\u09ae\u09a8 \u0986\u099b\u09c7 \u09a4\u09c7\u09ae\u09a8\u0964 Ones, Tens, Hundreds: \u09b8\u0982\u0996\u09cd\u09af\u09be\u099f\u09bf\u0995\u09c7 \u09a1\u09be\u09a8 \u09a6\u09bf\u0995 \u09a5\u09c7\u0995\u09c7 1, 2 \u09ac\u09be 3 \u0985\u0999\u09cd\u0995\u09c7\u09b0 \u099f\u09c1\u0995\u09b0\u09cb\u09af\u09bc \u09ad\u09be\u0997 \u0995\u09b0\u09c7 \u09aa\u09cd\u09b0\u09a4\u09bf\u099f\u09bf \u099f\u09c1\u0995\u09b0\u09cb \u098f\u0995\u099f\u09bf \u09b8\u0982\u0996\u09cd\u09af\u09be\u09b0 \u09ae\u09a4\u09cb \u09aa\u09a1\u09bc\u09ac\u09c7, \u09af\u09c7\u09ae\u09a8 \'\u09a6\u09c1\u0987\u09b6\u09cb \u099a\u09cc\u09a4\u09cd\u09b0\u09bf\u09b6\'\u0964 Group of 2, 3, 4, 5: \u099f\u09c1\u0995\u09b0\u09cb\u09af\u09bc \u09ad\u09be\u0997 \u0995\u09b0\u09c7 \u09aa\u09cd\u09b0\u09a4\u09bf\u099f\u09bf \u0985\u0999\u09cd\u0995 \u0986\u09b2\u09be\u09a6\u09be \u0995\u09b0\u09c7 \u09aa\u09a1\u09bc\u09ac\u09c7, \u099f\u09c1\u0995\u09b0\u09cb\u0997\u09c1\u09b2\u09cb\u09b0 \u09ae\u09be\u099d\u09c7 \u09a5\u09c7\u09ae\u09c7, \u09af\u09c7\u09ae\u09a8 \'2 3 4\'\u0964 \u0989\u09a6\u09be\u09b9\u09b0\u09a3: 1234567890 Hundreds-\u098f \u09aa\u09a1\u09bc\u09b2\u09c7 \'1, 234, 567, 890\'-\u098f\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u099f\u09bf \u099f\u09c1\u0995\u09b0\u09cb \u09b8\u0982\u0996\u09cd\u09af\u09be\u09b0 \u09ae\u09a4\u09cb \u09aa\u09a1\u09bc\u09be \u09b9\u09ac\u09c7\u0964 Group of 3-\u098f \'1, 2 3 4, 5 6 7, 8 9 0\'-\u098f\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u099f\u09bf \u0985\u0999\u09cd\u0995 \u0986\u09b2\u09be\u09a6\u09be \u0995\u09b0\u09c7 \u09aa\u09a1\u09bc\u09be \u09b9\u09ac\u09c7\u0964"

    aput-object v3, v2, v4

    .line 64
    const-string v3, "\u0628\u0691\u0627 \u0639\u062f\u062f \u06a9\u06cc\u0633\u06d2 \u067e\u0691\u06be\u0627 \u062c\u0627\u0626\u06d2\u06d4 None: \u062c\u06cc\u0633\u0627 \u06c1\u06d2 \u0648\u06cc\u0633\u0627\u06d4 Ones, Tens, Hundreds: \u0639\u062f\u062f \u06a9\u0648 \u062f\u0627\u0626\u06cc\u06ba \u0633\u06d2 1\u060c 2 \u06cc\u0627 3 \u06c1\u0646\u062f\u0633\u0648\u06ba \u06a9\u06d2 \u0679\u06a9\u0691\u0648\u06ba \u0645\u06cc\u06ba \u0628\u0627\u0646\u0679 \u06a9\u0631 \u06c1\u0631 \u0679\u06a9\u0691\u0627 \u0627\u06cc\u06a9 \u0639\u062f\u062f \u06a9\u06cc \u0637\u0631\u062d \u067e\u0691\u06be\u06d2 \u06af\u0627\u060c \u062c\u06cc\u0633\u06d2 \'\u062f\u0648 \u0633\u0648 \u0686\u0648\u0646\u062a\u06cc\u0633\'\u06d4 Group of 2, 3, 4, 5: \u0679\u06a9\u0691\u0648\u06ba \u0645\u06cc\u06ba \u0628\u0627\u0646\u0679 \u06a9\u0631 \u06c1\u0631 \u06c1\u0646\u062f\u0633\u06c1 \u0627\u0644\u06af \u0627\u0644\u06af \u067e\u0691\u06be\u06d2 \u06af\u0627\u060c \u0679\u06a9\u0691\u0648\u06ba \u06a9\u06d2 \u062f\u0631\u0645\u06cc\u0627\u0646 \u0631\u06a9 \u06a9\u0631\u060c \u062c\u06cc\u0633\u06d2 \'2 3 4\'\u06d4 \u0645\u062b\u0627\u0644: 1234567890 \u06a9\u0648 Hundreds \u0645\u06cc\u06ba \u067e\u0691\u06be\u0646\u06d2 \u067e\u0631 \'1, 234, 567, 890\' \u06a9\u0627 \u06c1\u0631 \u0679\u06a9\u0691\u0627 \u0639\u062f\u062f \u06a9\u06cc \u0637\u0631\u062d \u067e\u0691\u06be\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627\u06d4 Group of 3 \u0645\u06cc\u06ba \'1, 2 3 4, 5 6 7, 8 9 0\' \u06a9\u0627 \u06c1\u0631 \u06c1\u0646\u062f\u0633\u06c1 \u0627\u0644\u06af \u067e\u0691\u06be\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627\u06d4"

    aput-object v3, v2, v5

    .line 65
    const-string v3, "\u0643\u064a\u0641 \u062a\u064f\u0642\u0631\u0623 \u0627\u0644\u0623\u0631\u0642\u0627\u0645 \u0627\u0644\u0643\u0628\u064a\u0631\u0629. None: \u0643\u0645\u0627 \u0647\u064a. Ones \u0648Tens \u0648Hundreds: \u064a\u0642\u0633\u0651\u0645 \u0627\u0644\u0631\u0642\u0645 \u0645\u0646 \u0627\u0644\u064a\u0645\u064a\u0646 \u0625\u0644\u0649 \u0623\u062c\u0632\u0627\u0621 \u0645\u0646 1 \u0623\u0648 2 \u0623\u0648 3 \u0623\u0631\u0642\u0627\u0645 \u0648\u064a\u0642\u0631\u0623 \u0643\u0644 \u062c\u0632\u0621 \u0643\u0639\u062f\u062f\u060c \u0645\u062b\u0644 \'\u0645\u0626\u062a\u0627\u0646 \u0648\u0623\u0631\u0628\u0639\u0629 \u0648\u062b\u0644\u0627\u062b\u0648\u0646\'. Group of 2, 3, 4, 5: \u064a\u0642\u0633\u0651\u0645\u0647 \u0625\u0644\u0649 \u0623\u062c\u0632\u0627\u0621 \u0648\u064a\u0642\u0631\u0623 \u0643\u0644 \u0631\u0642\u0645 \u0639\u0644\u0649 \u062d\u062f\u0629 \u0645\u0639 \u062a\u0648\u0642\u0641 \u0628\u064a\u0646 \u0627\u0644\u0623\u062c\u0632\u0627\u0621\u060c \u0645\u062b\u0644 \'2 3 4\'. \u0645\u062b\u0627\u0644: \u0639\u0646\u062f \u0642\u0631\u0627\u0621\u0629 1234567890 \u0628\u062e\u064a\u0627\u0631 Hundreds \u064a\u064f\u0642\u0631\u0623 \u0643\u0644 \u062c\u0632\u0621 \u0645\u0646 \'1, 234, 567, 890\' \u0643\u0639\u062f\u062f. \u0648\u0641\u064a Group of 3 \u064a\u064f\u0642\u0631\u0623 \u0643\u0644 \u0631\u0642\u0645 \u0645\u0646 \'1, 2 3 4, 5 6 7, 8 9 0\' \u0639\u0644\u0649 \u062d\u062f\u0629."

    aput-object v3, v2, v6

    .line 62
    const-string v3, "\u092c\u0921\u093c\u0940 \u0938\u0902\u0916\u094d\u092f\u093e \u0915\u0948\u0938\u0947 \u092a\u0922\u093c\u0940 \u091c\u093e\u090f\u0964 None: \u091c\u0948\u0938\u0940 \u0939\u0948 \u0935\u0948\u0938\u0940\u0964 Ones, Tens, Hundreds: \u0938\u0902\u0916\u094d\u092f\u093e \u0915\u094b \u0926\u093e\u090f\u0901 \u0938\u0947 1, 2 \u092f\u093e 3 \u0905\u0902\u0915\u094b\u0902 \u0915\u0947 \u091f\u0941\u0915\u0921\u093c\u094b\u0902 \u092e\u0947\u0902 \u092c\u093e\u0901\u091f\u0915\u0930 \u0939\u0930 \u091f\u0941\u0915\u0921\u093c\u093e \u0938\u0902\u0916\u094d\u092f\u093e \u0915\u0940 \u0924\u0930\u0939 \u092a\u0922\u093c\u0947\u0917\u093e, \u091c\u0948\u0938\u0947 \'\u0926\u094b \u0938\u094c \u091a\u094c\u0902\u0924\u0940\u0938\'\u0964 Group of 2, 3, 4, 5: \u091f\u0941\u0915\u0921\u093c\u094b\u0902 \u092e\u0947\u0902 \u092c\u093e\u0901\u091f\u0915\u0930 \u0939\u0930 \u0905\u0902\u0915 \u0905\u0932\u0917-\u0905\u0932\u0917 \u092a\u0922\u093c\u0947\u0917\u093e, \u091f\u0941\u0915\u0921\u093c\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u0930\u0941\u0915\u0915\u0930, \u091c\u0948\u0938\u0947 \'2 3 4\'\u0964 \u0909\u0926\u093e\u0939\u0930\u0923: 1234567890 \u0915\u094b Hundreds \u092e\u0947\u0902 \u092a\u0922\u093c\u0928\u0947 \u092a\u0930 \'1, 234, 567, 890\' \u0915\u0947 \u0939\u0930 \u091f\u0941\u0915\u0921\u093c\u0947 \u0938\u0902\u0916\u094d\u092f\u093e \u0915\u0940 \u0924\u0930\u0939 \u092a\u0922\u093c\u0947 \u091c\u093e\u090f\u0901\u0917\u0947\u0964 Group of 3 \u092e\u0947\u0902 \'1, 2 3 4, 5 6 7, 8 9 0\' \u0915\u0947 \u0939\u0930 \u0905\u0902\u0915 \u0905\u0932\u0917 \u092a\u0922\u093c\u0947 \u091c\u093e\u090f\u0901\u0917\u0947\u0964"

