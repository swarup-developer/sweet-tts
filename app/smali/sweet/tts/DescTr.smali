    new-array v2, v1, [Ljava/lang/String;

    const-string v3, "\u09b6\u09c1\u09a7\u09c1 \u09af\u09c7 \u09ad\u09be\u09b7\u09be\u0997\u09c1\u09b2\u09cb \u0986\u09aa\u09a8\u09be\u09b0 \u09a6\u09b0\u0995\u09be\u09b0 \u09b8\u09c7\u0997\u09c1\u09b2\u09cb \u09ac\u09c7\u099b\u09c7 \u09a8\u09bf\u09a8, \u09ac\u09be\u0995\u09bf\u0997\u09c1\u09b2\u09cb \u0996\u09be\u09b2\u09bf \u09b0\u09be\u0996\u09c1\u09a8\u0964 \u09af\u09a4 \u0995\u09ae \u09ad\u09be\u09b7\u09be, \u09ad\u09be\u09b7\u09be \u099a\u09c7\u09a8\u09be \u09a4\u09a4 \u09a6\u09cd\u09b0\u09c1\u09a4 \u0993 \u09a8\u09bf\u09b0\u09cd\u09ad\u09c1\u09b2\u0964"

