    .line 105
    const-string v3, "\u062a\u064f\u0642\u0631\u0623 \u0627\u0644\u0631\u0633\u0627\u0644\u0629 \u0643\u0627\u0645\u0644\u0629 \u0628\u0635\u0648\u062a \u0648\u0627\u062d\u062f\u060c \u0647\u0648 \u0635\u0648\u062a \u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0623\u0643\u062b\u0631 \u0643\u0644\u0645\u0627\u062a \u0641\u064a \u0627\u0644\u0631\u0633\u0627\u0644\u0629."

    aput-object v3, v2, v6

    .line 102
    const-string v3, "\u092a\u0942\u0930\u093e \u0938\u0902\u0926\u0947\u0936 \u090f\u0915 \u0939\u0940 \u0906\u0935\u093e\u091c\u093c \u092e\u0947\u0902 \u092a\u0922\u093c\u0947\u0917\u093e\u0964 \u091c\u093f\u0938 \u092d\u093e\u0937\u093e \u0915\u0947 \u0938\u092c\u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0936\u092c\u094d\u0926 \u0939\u094b\u0902, \u0909\u0938\u0940 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0932\u0917\u0947\u0917\u0940\u0964"

