    const-string v3, "\u09af\u09c7 \u0985\u09cd\u09af\u09be\u09aa\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09b2\u09be\u09a6\u09be \u09ad\u09af\u09bc\u09c7\u09b8 \u099a\u09be\u09a8, \u09b8\u09c7\u099f\u09bf \u09ac\u09c7\u099b\u09c7 \u09a8\u09bf\u09a8\u0964"

