# static fields
.field public static final AMOUNT:Ljava/lang/String; = "\u0905\u0902\u0917\u094d\u0930\u0947\u091c\u093c\u0940 \u0906\u0935\u093e\u091c\u093c \u092e\u0947\u0902 6 \u0938\u0947 9 \u0905\u0902\u0915 \u0915\u0940 \u0930\u0915\u092e Million/Billion \u0915\u0940 \u091c\u0917\u0939 Lakh/Crore \u092e\u0947\u0902 \u092a\u0922\u093c\u0940 \u091c\u093e\u090f\u0917\u0940\u0964"

.field public static final AMOUNT_EN:Ljava/lang/String; = "Uses Crore/Lakh instead of Billion/Million for English Voices"

.field public static final APP_VOICE_INTRO:Ljava/lang/String; = "\u0907\u0938 \u0910\u092a \u092e\u0947\u0902 \u0939\u0930 \u092d\u093e\u0937\u093e \u0915\u0947 \u0932\u093f\u090f \u0905\u0932\u0917 \u0906\u0935\u093e\u091c\u093c \u091a\u0941\u0928\u093f\u090f\u0964 Same as global default \u0915\u093e \u092e\u0924\u0932\u092c \u0939\u0948 \u0915\u093f \u092c\u093e\u0915\u0940 \u091c\u0917\u0939 \u0935\u093e\u0932\u0940 \u0906\u0935\u093e\u091c\u093c \u0939\u0940 \u0932\u0917\u0947\u0917\u0940\u0964"

.field public static final CLEAR_CACHE:Ljava/lang/String; = "\u0910\u092a \u0915\u093e cache \u0938\u093e\u092b\u093c \u0915\u0930\u0924\u093e \u0939\u0948 \u0914\u0930 \u0938\u093e\u0930\u0940 \u0906\u0935\u093e\u091c\u093c\u0947\u0902 \u0935 \u0938\u0947\u091f\u093f\u0902\u0917 \u0924\u093e\u091c\u093c\u093e \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0906\u092a\u0915\u0940 \u0938\u0947\u091f\u093f\u0902\u0917 \u092e\u093f\u091f\u0924\u0940 \u0928\u0939\u0940\u0902\u0964"

.field public static final CLEAR_CACHE_EN:Ljava/lang/String; = "Clears this app\'s cache and refreshes all voices and preferences."

.field public static final CLEAR_DATA:Ljava/lang/String; = "\u0910\u092a \u0915\u0940 \u0938\u093e\u0930\u0940 \u0938\u0947\u091f\u093f\u0902\u0917 \u0914\u0930 \u0921\u0947\u091f\u093e \u092e\u093f\u091f\u093e\u0915\u0930 \u0936\u0941\u0930\u0941\u0906\u0924\u0940 \u0939\u093e\u0932\u0924 \u092e\u0947\u0902 \u0932\u0947 \u091c\u093e\u0924\u093e \u0939\u0948\u0964"

.field public static final DETAILED_LOG:Ljava/lang/String; = "\u0939\u0930 \u091a\u0930\u0923 \u0915\u093e \u092e\u093f\u0932\u0940\u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u0935\u093f\u0938\u094d\u0924\u0943\u0924 \u0930\u093f\u0915\u0949\u0930\u094d\u0921\u0964 \u0938\u093f\u0930\u094d\u092b \u091c\u093e\u0901\u091a \u0915\u0947 \u0938\u092e\u092f \u091a\u093e\u0932\u0942 \u0930\u0916\u0947\u0902\u0964"

.field public static final DICTIONARY:Ljava/lang/String; = "\u0915\u093f\u0938\u0940 \u0936\u092c\u094d\u0926 \u0915\u0940 \u091c\u0917\u0939 \u0926\u0942\u0938\u0930\u093e \u0936\u092c\u094d\u0926 \u092c\u094b\u0932\u0935\u093e\u0928\u093e, \u091c\u0948\u0938\u0947 \u0917\u0932\u0924 \u0909\u091a\u094d\u091a\u093e\u0930\u0923 \u0920\u0940\u0915 \u0915\u0930\u0928\u093e\u0964 \u0930\u093f\u092a\u094d\u0932\u0947\u0938\u092e\u0947\u0902\u091f \u0916\u093e\u0932\u0940 \u091b\u094b\u0921\u093c\u0947\u0902\u0917\u0947 \u0924\u094b \u0935\u0939 \u0936\u092c\u094d\u0926 \u092c\u094b\u0932\u093e \u0939\u0940 \u0928\u0939\u0940\u0902 \u091c\u093e\u090f\u0917\u093e\u0964"

.field public static final DICTIONARY_EN:Ljava/lang/String; = "Add or edit find/replace entries"

.field public static final DICT_ENTRIES_INTRO:Ljava/lang/String; = "Add Entry \u0938\u0947 \u0928\u0908 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f\u093f \u091c\u094b\u0921\u093c\u093f\u090f: \u0915\u094c\u0928 \u0938\u093e \u0936\u092c\u094d\u0926 \u0914\u0930 \u0909\u0938\u0915\u0940 \u091c\u0917\u0939 \u0915\u094d\u092f\u093e \u092c\u094b\u0932\u0928\u093e \u0939\u0948\u0964 \u0930\u093f\u092a\u094d\u0932\u0947\u0938\u092e\u0947\u0902\u091f \u0916\u093e\u0932\u0940 \u091b\u094b\u0921\u093c\u0947\u0902\u0917\u0947 \u0924\u094b \u0935\u0939 \u0936\u092c\u094d\u0926 \u092c\u094b\u0932\u093e \u0939\u0940 \u0928\u0939\u0940\u0902 \u091c\u093e\u090f\u0917\u093e\u0964 \u091c\u0948\u0938\u0947 Maybe \u092a\u0939\u0932\u0947 \u0938\u0947 \u0916\u093e\u0932\u0940 \u0930\u093f\u092a\u094d\u0932\u0947\u0938\u092e\u0947\u0902\u091f \u0915\u0947 \u0938\u093e\u0925 \u091c\u0941\u0921\u093c\u093e \u0939\u0948, \u0907\u0938\u0932\u093f\u090f WhatsApp \u0915\u0940 \u091a\u0948\u091f \u092e\u0947\u0902 \u092f\u0939 \u0932\u0947\u092c\u0932 \u0938\u0941\u0928\u093e\u0908 \u0928\u0939\u0940\u0902 \u0926\u0947\u0924\u093e\u0964"

.field public static final DICT_EXPORT:Ljava/lang/String; = "\u0921\u093f\u0915\u094d\u0936\u0928\u0930\u0940 \u0915\u094b \u092b\u093e\u0907\u0932 \u092e\u0947\u0902 \u0938\u0947\u0935 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"

.field public static final DICT_IMPORT:Ljava/lang/String; = "\u092a\u0939\u0932\u0947 \u0938\u0947\u0935 \u0915\u0940 \u0939\u0941\u0908 \u0921\u093f\u0915\u094d\u0936\u0928\u0930\u0940 \u0915\u0940 \u092b\u093e\u0907\u0932 \u0935\u093e\u092a\u0938 \u0932\u093e\u0924\u093e \u0939\u0948\u0964"

.field public static final GOOGLE_CLEAR_DATA:Ljava/lang/String; = "App Info \u0915\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0916\u0941\u0932\u0947\u0917\u0940\u0964 \u0935\u0939\u093e\u0901 Clear data \u092c\u091f\u0928 \u0922\u0942\u0901\u0922\u0915\u0930 \u0921\u0947\u091f\u093e \u0938\u093e\u092b\u093c \u0915\u0940\u091c\u093f\u090f\u0964 \u0910\u092a \u0915\u0940 \u092a\u0939\u0932\u0940 \u0938\u0947\u091f\u093f\u0902\u0917 \u0915\u0947 \u0938\u092e\u092f \u092f\u0939 \u090f\u0915 \u092c\u093e\u0930 \u0915\u0930\u0928\u093e \u091c\u093c\u0930\u0942\u0930\u0940 \u0939\u0948\u0964 \u092c\u093e\u0926 \u092e\u0947\u0902 \u092d\u0940 \u091c\u092c Google TTS \u0905\u091f\u0915\u0947 \u092f\u093e \u0917\u0921\u093c\u092c\u0921\u093c \u0915\u0930\u0947, \u0924\u094b \u0926\u094b\u092c\u093e\u0930\u093e \u0915\u0930\u0928\u093e \u092a\u0921\u093c \u0938\u0915\u0924\u093e \u0939\u0948\u0964"

.field public static final GOOGLE_CLEAR_DATA_EN:Ljava/lang/String; = "This will open Google TTS App Info screen, find Clear Data option & use it"

.field public static final GOOGLE_DOWNLOAD:Ljava/lang/String; = "Google \u0915\u0940 \u0906\u0935\u093e\u091c\u093c\u0947\u0902 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0916\u0941\u0932\u0947\u0917\u0940\u0964 \u0938\u093f\u0930\u094d\u092b \u0935\u0939\u0940 \u092d\u093e\u0937\u093e\u090f\u0901 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0940\u091c\u093f\u090f \u091c\u094b \u0906\u092a\u0915\u094b \u091a\u093e\u0939\u093f\u090f\u0964"

.field public static final GOOGLE_DOWNLOAD_EN:Ljava/lang/String; = "Opens Google TTS\'s own voice download screen"

.field public static final GOOGLE_LANG_DETECT:Ljava/lang/String; = "Google TTS \u0915\u0940 \u0938\u0947\u091f\u093f\u0902\u0917 \u0916\u0941\u0932\u0947\u0917\u0940\u0964 \u0935\u0939\u093e\u0901 Language detection \u092e\u0947\u0902 \u0924\u0940\u0928 \u0935\u093f\u0915\u0932\u094d\u092a \u0906\u0924\u0947 \u0939\u0948\u0902, \u0909\u0928\u092e\u0947\u0902 \u0938\u0947 Off \u091a\u0941\u0928 \u0932\u0940\u091c\u093f\u090f\u0964 \u0910\u092a \u0915\u0947 \u0920\u0940\u0915 \u0938\u0947 \u0915\u093e\u092e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092f\u0939 \u091c\u093c\u0930\u0942\u0930\u0940 \u0939\u0948\u0964"

.field public static final GOOGLE_LANG_DETECT_EN:Ljava/lang/String; = "Opens Google TTS settings, find Language detection & turn it off"

.field public static final GOOGLE_TTS_INTRO:Ljava/lang/String; = "\u0911\u0932 \u0907\u0928 \u0935\u0928 \u0915\u094b \u0920\u0940\u0915 \u0938\u0947 \u091a\u0932\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f Google TTS \u0915\u0940 \u092f\u0947 \u0924\u0940\u0928 \u0938\u0947\u091f\u093f\u0902\u0917 \u0915\u0930\u0928\u093e \u091c\u093c\u0930\u0942\u0930\u0940 \u0939\u0948\u0964"

.field public static final INSTANCE:Lsweet/tts/Desc;

.field public static final KEEP_RUNNING:Ljava/lang/String; = "\u091c\u092c \u0915\u094b\u0908 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0930\u0940\u0921\u0930 \u0911\u0932 \u0907\u0928 \u0935\u0928 \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930 \u0930\u0939\u093e \u0939\u094b, \u0924\u092c \u090f\u0915 \u091b\u094b\u091f\u0940 \u0938\u0942\u091a\u0928\u093e \u0926\u093f\u0916\u093e\u0915\u0930 \u0910\u092a \u0915\u094b \u092c\u0948\u0915\u0917\u094d\u0930\u093e\u0909\u0902\u0921 \u092e\u0947\u0902 \u091a\u093e\u0932\u0942 \u0930\u0916\u0924\u093e \u0939\u0948, \u0924\u093e\u0915\u093f \u092b\u093c\u094b\u0928 \u0909\u0938\u0947 \u092c\u0902\u0926 \u0928 \u0915\u0930\u0947\u0964 \u092c\u0948\u091f\u0930\u0940 \u0928\u0939\u0940\u0902 \u0916\u093e\u0924\u093e\u0964"

.field public static final KEEP_RUNNING_EN:Ljava/lang/String; = "Shows a quiet notification while a screen reader uses All In One, so the phone does not close it in the background"

