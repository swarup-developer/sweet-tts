.field public static final LANGUAGES_INTRO:Ljava/lang/String; = "\u0938\u093f\u0930\u094d\u092b \u0935\u0939\u0940 \u092d\u093e\u0937\u093e\u090f\u0901 \u091a\u0941\u0928\u093f\u090f \u091c\u094b \u0906\u092a\u0915\u094b \u091a\u093e\u0939\u093f\u090f, \u092c\u093e\u0915\u0940 \u0916\u093e\u0932\u0940 \u0930\u0916\u093f\u090f\u0964 \u091c\u093f\u0924\u0928\u0940 \u0915\u092e \u092d\u093e\u0937\u093e\u090f\u0901, \u0909\u0924\u0928\u0940 \u0924\u0947\u091c\u093c \u0914\u0930 \u0938\u0939\u0940 \u092a\u0939\u091a\u093e\u0928\u0964"

.field public static final LOGGING:Ljava/lang/String; = "\u0910\u092a \u0915\u0940 \u0917\u0924\u093f\u0935\u093f\u0927\u093f \u0915\u093e \u091b\u094b\u091f\u093e \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u0930\u0916\u0924\u093e \u0939\u0948, \u0917\u0921\u093c\u092c\u0921\u093c\u0940 \u091c\u093e\u0901\u091a\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f\u0964"

.field public static final LOG_CLEAR:Ljava/lang/String; = "\u0932\u0949\u0917 \u092e\u093f\u091f\u093e\u0924\u093e \u0939\u0948\u0964"

.field public static final LOG_OPEN:Ljava/lang/String; = "\u0932\u0949\u0917 \u0916\u094b\u0932\u0915\u0930 \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948\u0964"

.field public static final LOG_SAVE:Ljava/lang/String; = "\u0932\u0949\u0917 \u0915\u0940 \u0915\u0949\u092a\u0940 \u092b\u094b\u0928 \u0915\u0947 Documents \u092b\u094b\u0932\u094d\u0921\u0930 \u092e\u0947\u0902, All In One TTS \u0928\u093e\u092e \u0915\u0947 \u092b\u094b\u0932\u094d\u0921\u0930 \u092e\u0947\u0902 \u0930\u0916\u0924\u093e \u0939\u0948\u0964"

.field public static final LOG_SHARE:Ljava/lang/String; = "\u0932\u0949\u0917 \u0915\u0940 \u092b\u093e\u0907\u0932 \u0926\u0942\u0938\u0930\u0940 \u0910\u092a \u092e\u0947\u0902 \u092d\u0947\u091c\u0924\u093e \u0939\u0948\u0964"

.field public static final LONG_NUMBER:Ljava/lang/String; = "\u092c\u0921\u093c\u0940 \u0938\u0902\u0916\u094d\u092f\u093e \u0915\u0948\u0938\u0947 \u092a\u0922\u093c\u0940 \u091c\u093e\u090f\u0964 None: \u091c\u0948\u0938\u0940 \u0939\u0948 \u0935\u0948\u0938\u0940\u0964 Ones, Tens, Hundreds: \u0938\u0902\u0916\u094d\u092f\u093e \u0915\u094b \u0926\u093e\u090f\u0901 \u0938\u0947 1, 2 \u092f\u093e 3 \u0905\u0902\u0915\u094b\u0902 \u0915\u0947 \u091f\u0941\u0915\u0921\u093c\u094b\u0902 \u092e\u0947\u0902 \u092c\u093e\u0901\u091f\u0915\u0930 \u0939\u0930 \u091f\u0941\u0915\u0921\u093c\u093e \u0938\u0902\u0916\u094d\u092f\u093e \u0915\u0940 \u0924\u0930\u0939 \u092a\u0922\u093c\u0947\u0917\u093e, \u091c\u0948\u0938\u0947 \'\u0926\u094b \u0938\u094c \u091a\u094c\u0902\u0924\u0940\u0938\'\u0964 Group of 2, 3, 4, 5: \u091f\u0941\u0915\u0921\u093c\u094b\u0902 \u092e\u0947\u0902 \u092c\u093e\u0901\u091f\u0915\u0930 \u0939\u0930 \u0905\u0902\u0915 \u0905\u0932\u0917-\u0905\u0932\u0917 \u092a\u0922\u093c\u0947\u0917\u093e, \u091f\u0941\u0915\u0921\u093c\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u0930\u0941\u0915\u0915\u0930, \u091c\u0948\u0938\u0947 \'2 3 4\'\u0964 \u0909\u0926\u093e\u0939\u0930\u0923: 1234567890 \u0915\u094b Hundreds \u092e\u0947\u0902 \u092a\u0922\u093c\u0928\u0947 \u092a\u0930 \'1, 234, 567, 890\' \u0915\u0947 \u0939\u0930 \u091f\u0941\u0915\u0921\u093c\u0947 \u0938\u0902\u0916\u094d\u092f\u093e \u0915\u0940 \u0924\u0930\u0939 \u092a\u0922\u093c\u0947 \u091c\u093e\u090f\u0901\u0917\u0947\u0964 Group of 3 \u092e\u0947\u0902 \'1, 2 3 4, 5 6 7, 8 9 0\' \u0915\u0947 \u0939\u0930 \u0905\u0902\u0915 \u0905\u0932\u0917 \u092a\u0922\u093c\u0947 \u091c\u093e\u090f\u0901\u0917\u0947\u0964"

.field public static final LONG_NUMBER_APPLIES:Ljava/lang/String; = "\u090a\u092a\u0930 \u0915\u0940 \u0938\u0947\u091f\u093f\u0902\u0917 \u0915\u093f\u0924\u0928\u0947 \u0905\u0902\u0915\u094b\u0902 \u0938\u0947 \u0932\u0917\u0947\u0964 8 \u091a\u0941\u0928\u0928\u0947 \u092a\u0930 \u0938\u093f\u0930\u094d\u092b 8 \u092f\u093e \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0905\u0902\u0915\u094b\u0902 \u0915\u0940 \u0938\u0902\u0916\u094d\u092f\u093e \u092a\u0930 \u0932\u0917\u0947\u0917\u0940, \u091b\u094b\u091f\u0940 \u0938\u0902\u0916\u094d\u092f\u093e \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u092a\u0922\u093c\u0940 \u091c\u093e\u090f\u0917\u0940\u0964 4 \u0905\u0902\u0915 \u0905\u0915\u094d\u0938\u0930 \u0938\u093e\u0932 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902, \u0907\u0938\u0932\u093f\u090f \u091a\u0941\u0928\u093e\u0935 5 \u0938\u0947 \u0936\u0941\u0930\u0942 \u0939\u094b\u0924\u093e \u0939\u0948\u0964"

.field public static final MOBILE:Ljava/lang/String; = "\u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0915\u093f\u0928 \u091f\u0941\u0915\u0921\u093c\u094b\u0902 \u092e\u0947\u0902 \u092a\u0922\u093c\u093e \u091c\u093e\u090f, \u0907\u0938\u0915\u093e \u091a\u0941\u0928\u093e\u0935\u0964 \u0939\u0930 \u0905\u0902\u0915 \u0905\u0932\u0917-\u0905\u0932\u0917 \u092a\u0922\u093c\u093e \u091c\u093e\u090f\u0917\u093e \u0914\u0930 \u091f\u0941\u0915\u0921\u093c\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u0930\u0941\u0915\u0947\u0917\u093e\u0964 \u0935\u093f\u0915\u0932\u094d\u092a\u094b\u0902 \u0915\u0947 \u0928\u093e\u092e \u092e\u0947\u0902 \u0926\u093f\u0916\u0947 \u091f\u0941\u0915\u0921\u093c\u0947 \u0939\u0940 \u0905\u0938\u0932 \u092e\u0947\u0902 \u092c\u0928\u0947\u0902\u0917\u0947\u0964 \u0909\u0926\u093e\u0939\u0930\u0923: +91 98765 43210 \u0915\u094b 5-5 \u0935\u093e\u0932\u0947 \u0935\u093f\u0915\u0932\u094d\u092a \u092e\u0947\u0902 \'9 1, 9 8 7 6 5, 4 3 2 1 0\' \u092a\u0922\u093c\u093e \u091c\u093e\u090f\u0917\u093e\u0964"

.field public static final MORE_VOICES:Ljava/lang/String; = "\u0907\u0938 \u092c\u091f\u0928 \u0938\u0947 \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 Vocalizer \u0906\u0935\u093e\u091c\u093c\u0947\u0902 \u090f\u0915 \u092b\u094b\u0932\u094d\u0921\u0930 \u0938\u0947 \u091c\u094b\u0921\u093c\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0902\u0964 \u0939\u0930 \u091a\u0930\u0923 \u092a\u0930 \u092c\u091f\u0928 \u0915\u093e \u0928\u093e\u092e \u092c\u0926\u0932 \u091c\u093e\u0924\u093e \u0939\u0948 \u0914\u0930 \u092c\u0924\u093e\u0924\u093e \u0939\u0948 \u0915\u093f \u0905\u0917\u0932\u093e \u0915\u093e\u092e \u0915\u094d\u092f\u093e \u0939\u0948\u0964"

.field public static final NUMBERS_BTN:Ljava/lang/String; = "\u0938\u0902\u0916\u094d\u092f\u093e\u090f\u0901, \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0914\u0930 OTP \u0915\u0948\u0938\u0947 \u092a\u0922\u093c\u0947 \u091c\u093e\u090f\u0901\u0964"

.field public static final OTHER_BTN:Ljava/lang/String; = "Dictionary, \u0932\u0949\u0917 \u0914\u0930 \u092c\u093e\u0915\u0940 \u0938\u0947\u091f\u093f\u0902\u0917\u0964"

.field public static final OTP:Ljava/lang/String; = "\u0938\u0902\u0926\u0947\u0936 \u092e\u0947\u0902 OTP \u092e\u093f\u0932\u0947 \u0924\u094b \u0909\u0938\u0947 \u0905\u0902\u0915-\u0905\u0902\u0915 \u0915\u0930\u0915\u0947 \u0930\u0941\u0915-\u0930\u0941\u0915\u0915\u0930 \u092a\u0922\u093c\u0947\u0917\u093e\u0964 OTP \u092a\u0922\u093c\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 40 \u0938\u0947\u0915\u0902\u0921 \u0924\u0915 \u0906\u092a \u092b\u094b\u0928 \u0915\u094b \u0936\u0947\u0915 \u0915\u0930\u0947\u0902\u0917\u0947, \u0924\u094b \u0939\u0930 \u0936\u0947\u0915 \u092a\u0930 \u0935\u0939 OTP \u092b\u093f\u0930 \u0938\u0947 \u0938\u0941\u0928\u093e\u090f\u0917\u093e\u0964 \u0928\u092f\u093e OTP \u0906\u0924\u0947 \u0939\u0940 40 \u0938\u0947\u0915\u0902\u0921 \u092b\u093f\u0930 \u0938\u0947 \u0936\u0941\u0930\u0942 \u0939\u094b \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964"

.field public static final OTP_AFTER:Ljava/lang/String; = "OTP \u0906\u0928\u0947 \u0915\u0947 \u0915\u093f\u0924\u0928\u0947 \u0938\u0947\u0915\u0902\u0921 \u092c\u093e\u0926 clipboard \u092e\u0947\u0902 \u0915\u0949\u092a\u0940 \u0939\u094b\u0964 \u0926\u0947\u0930 \u0930\u0916\u0928\u0947 \u0938\u0947 \'Copied\' \u0915\u0940 \u0918\u094b\u0937\u0923\u093e \u0938\u0902\u0926\u0947\u0936 \u092a\u0922\u093c\u0924\u0947 \u0938\u092e\u092f \u092c\u0940\u091a \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u0906\u0924\u0940\u0964"

.field public static final OTP_CLIPBOARD:Ljava/lang/String; = "\u091a\u0941\u0928\u0947 \u0939\u0941\u090f \u0938\u0947\u0915\u0902\u0921 \u0915\u0947 \u092c\u093e\u0926 OTP \u0905\u092a\u0928\u0947 \u0906\u092a clipboard \u092e\u0947\u0902 \u0915\u0949\u092a\u0940 \u0939\u094b \u091c\u093e\u090f\u0917\u093e, \u0924\u093e\u0915\u093f \u0906\u092a \u0909\u0938\u0947 OTP \u092d\u0930\u0928\u0947 \u0915\u0940 \u091c\u0917\u0939 \u092a\u0930 \u0906\u0930\u093e\u092e \u0938\u0947 paste \u0915\u0930 \u0938\u0915\u0947\u0902\u0964"

.field public static final PERAPP_ADD_NOPERM:Ljava/lang/String; = "\u092a\u0939\u0932\u0940 \u092c\u093e\u0930 Usage Access \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0928\u0940 \u0939\u094b\u0917\u0940, \u0924\u093e\u0915\u093f \u0910\u092a \u091c\u093e\u0928 \u0938\u0915\u0947 \u0915\u093f \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 \u0915\u094c\u0928 \u0938\u0940 \u0910\u092a \u0916\u0941\u0932\u0940 \u0939\u0948\u0964 \u092f\u0939 \u0905\u0928\u0941\u092e\u0924\u093f App info \u0915\u0940 Permissions \u0938\u0942\u091a\u0940 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u0906\u0924\u0940\u0964 \u092f\u0939 \u092b\u094b\u0928 \u0915\u0940 Settings \u092e\u0947\u0902 Special app access \u0915\u0947 \u0905\u0902\u0926\u0930 Usage access \u092e\u0947\u0902 \u092e\u093f\u0932\u0924\u0940 \u0939\u0948\u0964 \u0905\u0917\u0930 \u0935\u0939\u093e\u0901 \u0938\u094d\u0935\u093f\u091a \u0911\u0928 \u0928 \u0939\u094b \u0914\u0930 \u092b\u094b\u0928 restricted setting \u0915\u093e \u0938\u0902\u0926\u0947\u0936 \u0926\u093f\u0916\u093e\u090f, \u0924\u094b Settings \u092e\u0947\u0902 Apps \u092e\u0947\u0902 All In One TTS \u0916\u094b\u0932\u0915\u0930 App info \u092e\u0947\u0902 \u091c\u093e\u0907\u090f\u0964 \u090a\u092a\u0930 \u0926\u093e\u090f\u0901 \u0915\u094b\u0928\u0947 \u092e\u0947\u0902 More options (\u0924\u0940\u0928 \u092c\u093f\u0902\u0926\u0941) \u0926\u092c\u093e\u0915\u0930 Allow restricted settings \u091a\u0941\u0928\u093f\u090f, \u092b\u093f\u0930 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u094b\u092c\u093e\u0930\u093e \u0926\u0940\u091c\u093f\u090f\u0964"

.field public static final PERAPP_ADD_NOPERM_EN:Ljava/lang/String; = "First tap: grant Usage Access permission (needed to tell which app is on screen)"

.field public static final PERAPP_ADD_OK:Ljava/lang/String; = "\u091c\u093f\u0938 \u0910\u092a \u0915\u0947 \u0932\u093f\u090f \u0905\u0932\u0917 \u0906\u0935\u093e\u091c\u093c \u091a\u093e\u0939\u093f\u090f, \u0909\u0938\u0947 \u091c\u094b\u0921\u093c\u093f\u090f\u0964 \u091c\u094b\u0921\u093c\u0940 \u0939\u0941\u0908 \u0910\u092a \u0915\u094b \u0939\u091f\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0909\u0938\u0915\u0947 \u0928\u093e\u092e \u0915\u094b \u0926\u0947\u0930 \u0924\u0915 \u0926\u092c\u093e\u0907\u090f (long press)\u0964"

.field public static final PERAPP_PICK:Ljava/lang/String; = "\u091c\u093f\u0938 \u0910\u092a \u0915\u0947 \u0932\u093f\u090f \u0905\u0932\u0917 \u0906\u0935\u093e\u091c\u093c \u091a\u093e\u0939\u093f\u090f, \u0909\u0938\u0947 \u091a\u0941\u0928\u093f\u090f\u0964"

.field public static final PER_APP:Ljava/lang/String; = "\u0905\u0932\u0917-\u0905\u0932\u0917 \u0910\u092a \u0915\u0947 \u0932\u093f\u090f \u0905\u0932\u0917 \u0906\u0935\u093e\u091c\u093c \u091a\u0941\u0928\u093f\u090f, \u091c\u0948\u0938\u0947 WhatsApp \u0915\u0940 \u0905\u0932\u0917 \u0914\u0930 YouTube \u0915\u0940 \u0905\u0932\u0917\u0964 \u0907\u0938\u0915\u0947 \u0932\u093f\u090f Usage Access \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u091a\u093e\u0939\u093f\u090f\u0964"

.field public static final PUNCTUATION:Ljava/lang/String; = "@ # % \u0914\u0930 \u092c\u094d\u0930\u0948\u0915\u0947\u091f \u091c\u0948\u0938\u0947 \u091a\u093f\u0939\u094d\u0928 \u0915\u093f\u0924\u0928\u0947 \u092c\u094b\u0932\u0947 \u091c\u093e\u090f\u0901\u0964 Engine decides: \u0915\u094b\u0908 \u092a\u094d\u0930\u094b\u0938\u0947\u0938\u093f\u0902\u0917 \u0928\u0939\u0940\u0902, \u0906\u0935\u093e\u091c\u093c \u0916\u0941\u0926 \u0924\u092f \u0915\u0930\u0924\u0940 \u0939\u0948 \u0915\u094d\u092f\u093e \u092c\u094b\u0932\u0928\u093e \u0939\u0948\u0964 None: \u0915\u094b\u0908 \u091a\u093f\u0939\u094d\u0928 \u0928\u0939\u0940\u0902 \u092c\u094b\u0932\u093e \u091c\u093e\u090f\u0917\u093e, \u0938\u093f\u0930\u094d\u092b % @ & + \u00b0 \u0936\u092c\u094d\u0926\u094b\u0902 \u092e\u0947\u0902 \u092a\u0922\u093c\u0947 \u091c\u093e\u090f\u0901\u0917\u0947 \u0914\u0930 \u0930\u0941\u0915\u093e\u0935\u091f \u092c\u0928\u0940 \u0930\u0939\u0947\u0917\u0940\u0964 Some: \u0925\u094b\u0921\u093c\u0947, Most: \u091c\u093c\u094d\u092f\u093e\u0926\u093e\u0924\u0930, All: \u0938\u092c\u0964"

.field public static final QUICK_START:Ljava/lang/String; = "\u0932\u0902\u092c\u0947 \u0938\u0902\u0926\u0947\u0936 \u0915\u093e \u092a\u0939\u0932\u093e \u0935\u093e\u0915\u094d\u092f \u0924\u0941\u0930\u0902\u0924 \u092c\u094b\u0932\u0928\u093e \u0936\u0941\u0930\u0942 \u0915\u0930\u0924\u093e \u0939\u0948, \u092c\u093e\u0915\u0940 \u0939\u093f\u0938\u094d\u0938\u0947 \u0915\u0940 \u092d\u093e\u0937\u093e \u092a\u0940\u091b\u0947 \u0938\u0947 \u092a\u0939\u091a\u093e\u0928\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964"

.field public static final QUICK_START_EN:Ljava/lang/String; = "Starts speaking right away instead of waiting for the whole message"

.field public static final SETTINGS_EXPORT:Ljava/lang/String; = "\u0910\u092a \u0915\u0940 \u0938\u0947\u091f\u093f\u0902\u0917 \u092b\u093e\u0907\u0932 \u092e\u0947\u0902 \u0938\u0947\u0935 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0907\u0938\u092e\u0947\u0902 \u0921\u093f\u0915\u094d\u0936\u0928\u0930\u0940 \u0914\u0930 \u0910\u092a-\u0935\u093e\u0930 \u0906\u0935\u093e\u091c\u093c\u0947\u0902 \u0936\u093e\u092e\u093f\u0932 \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u0940\u0902\u0964"

.field public static final SETTINGS_IMPORT:Ljava/lang/String; = "\u0938\u0947\u0935 \u0915\u0940 \u0939\u0941\u0908 \u0938\u0947\u091f\u093f\u0902\u0917 \u0935\u093e\u092a\u0938 \u0932\u093e\u0924\u093e \u0939\u0948\u0964"

.field public static final SLIDER_INTRO:Ljava/lang/String; = "\u0907\u0938 \u0906\u0935\u093e\u091c\u093c \u0915\u093e \u0935\u0949\u0932\u094d\u092f\u0942\u092e, \u0930\u092b\u093c\u094d\u0924\u093e\u0930 \u0914\u0930 \u092a\u093f\u091a\u0964 Play Sample \u0938\u0947 \u0938\u0941\u0928\u0915\u0930 \u091c\u093e\u0901\u091a\u093f\u090f\u0964 -1% \u0914\u0930 +1% \u092c\u091f\u0928 \u0938\u0947 \u092c\u093e\u0930\u0940\u0915 \u092c\u0926\u0932\u093e\u0935 \u0915\u0940\u091c\u093f\u090f\u0964"

.field public static final VOICES:Ljava/lang/String; = "\u0939\u0930 \u092d\u093e\u0937\u093e \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u0940 \u092a\u0938\u0902\u0926 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u091a\u0941\u0928\u093f\u090f\u0964"

.field public static final VOLUME_RATE_PITCH:Ljava/lang/String; = "\u0906\u0935\u093e\u091c\u093c \u0915\u0940 \u0924\u0947\u091c\u093c\u0940, \u0930\u092b\u093c\u094d\u0924\u093e\u0930 \u0914\u0930 \u092a\u093f\u091a \u092f\u0939\u093e\u0901 \u092c\u0926\u0932\u0940 \u091c\u093e \u0938\u0915\u0924\u0940 \u0939\u0948\u0964 \u0907\u0928\u094d\u0939\u0947\u0902 \u0924\u092d\u0940 \u092c\u0926\u0932\u093f\u090f \u091c\u092c \u091c\u093c\u0930\u0942\u0930\u0924 \u0939\u094b\u0964 \u0906\u092e \u0924\u094c\u0930 \u092a\u0930 \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u092b\u094b\u0928 \u0915\u0940 \u0938\u093f\u0938\u094d\u091f\u092e \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0938\u0947 \u0930\u0916\u093f\u090f, \u0914\u0930 \u0930\u092b\u093c\u094d\u0924\u093e\u0930 \u0935 \u092a\u093f\u091a TalkBack \u092f\u093e Jieshuo \u0915\u0940 \u0905\u092a\u0928\u0940 \u0938\u0947\u091f\u093f\u0902\u0917 \u0938\u0947\u0964 \u092f\u0939\u093e\u0901 \u0915\u0940 \u0938\u0947\u091f\u093f\u0902\u0917 \u0909\u0928\u0915\u0940 \u0938\u0947\u091f\u093f\u0902\u0917 \u0915\u0947 \u0938\u093e\u0925 \u092e\u093f\u0932\u0915\u0930 \u0905\u0938\u0930 \u0915\u0930\u0924\u0940 \u0939\u0948, \u0907\u0938\u0932\u093f\u090f \u092f\u0939\u093e\u0901 \u092c\u0926\u0932\u093e\u0935 \u0924\u092d\u0940 \u0915\u0930\u0947\u0902 \u091c\u092c \u0926\u094b \u092d\u093e\u0937\u093e\u0913\u0902 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c\u094b\u0902 \u092e\u0947\u0902 \u0906\u092a\u0938 \u092e\u0947\u0902 \u092b\u0930\u094d\u0915 \u0932\u0917\u0947\u0964"

.field public static final WHATS_NEW_BTN:Ljava/lang/String; = "2.0 \u092e\u0947\u0902 \u0928\u092f\u093e \u0915\u094d\u092f\u093e \u0939\u0948, \u092f\u0939 \u0926\u094b\u092c\u093e\u0930\u093e \u0926\u0947\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u0914\u0930 \u0935\u093f\u0935\u0930\u0923 \u0915\u0940 \u092d\u093e\u0937\u093e \u092c\u0926\u0932\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f\u0964"

.field public static final WHATS_NEW_BTN_EN:Ljava/lang/String; = "Shows what is new in version 2.0 again, and lets you choose the language of the descriptions: Off, Hindi, Bengali, Urdu or Arabic."

.field public static final WHOLE_MESSAGE:Ljava/lang/String; = "\u092a\u0942\u0930\u093e \u0938\u0902\u0926\u0947\u0936 \u090f\u0915 \u0939\u0940 \u0906\u0935\u093e\u091c\u093c \u092e\u0947\u0902 \u092a\u0922\u093c\u0947\u0917\u093e\u0964 \u091c\u093f\u0938 \u092d\u093e\u0937\u093e \u0915\u0947 \u0938\u092c\u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0936\u092c\u094d\u0926 \u0939\u094b\u0902, \u0909\u0938\u0940 \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0932\u0917\u0947\u0917\u0940\u0964"


