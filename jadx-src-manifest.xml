<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="122"
    android:versionName="3.1"
    android:compileSdkVersion="36"
    android:compileSdkVersionCodename="16"
    package="aio.tts"
    platformBuildVersionCode="36"
    platformBuildVersionName="16">
    <uses-sdk
        android:minSdkVersion="29"
        android:targetSdkVersion="36"/>
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"/>
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"/>
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <queries>
        <package android:name="tts.smartvoice"/>
        <package android:name="com.google.android.tts"/>
        <package android:name="com.google.android.marvin.talkback"/>
        <package android:name="com.samsung.android.accessibility.talkback"/>
        <package android:name="com.nirenr.talkman"/>
        <package android:name="com.nirenr.talkman.geek"/>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.HOME"/>
        </intent>
    </queries>
    <permission
        android:name="aio.tts.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature"/>
    <uses-permission android:name="aio.tts.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"/>
    <application
        android:theme="@style/AppTheme"
        android:label="Sweet TTS"
        android:name="aio.tts.App"
        android:allowBackup="false"
        android:extractNativeLibs="false"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:requestLegacyExternalStorage="true"
        android:allowNativeHeapPointerTagging="false"
        android:memtagMode="off">
        <activity
            android:label="Sweet TTS"
            android:name="aio.tts.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
            android:label="Voices"
            android:name="aio.tts.VoicesActivity"
            android:exported="false"/>
        <activity
            android:label="Volume, Rate and Pitch"
            android:name="aio.tts.VolumeRatePitchActivity"
            android:exported="false"/>
        <activity
            android:label="Voice settings"
            android:name="aio.tts.VoiceSlidersActivity"
            android:exported="false"/>
        <activity
            android:label="Eloquence voice settings"
            android:name="aio.tts.EloquenceSettingsActivity"
            android:exported="false"/>
        <activity
            android:label="Languages"
            android:name="aio.tts.LanguageSwitchingActivity"
            android:exported="false"/>
        <activity
            android:label="Settings"
            android:name="aio.tts.SettingsActivity"
            android:exported="false"/>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:exported="false"
            android:authorities="aio.tts.fileprovider"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>
        <activity
            android:label="Numbers"
            android:name="aio.tts.NumbersActivity"
            android:exported="false"/>
        <activity
            android:label="Dictionary"
            android:name="aio.tts.DictionaryActivity"
            android:exported="false"/>
        <activity
            android:label="Google TTS Settings"
            android:name="aio.tts.GoogleTtsSettingsActivity"
            android:exported="false"/>
        <activity
            android:label="Dictionary"
            android:name="aio.tts.DictionaryEntriesActivity"
            android:exported="false"/>
        <activity
            android:label="Per Application Voices"
            android:name="aio.tts.PerApplicationActivity"
            android:exported="false"/>
        <activity
            android:label="Add Application"
            android:name="aio.tts.AddAppActivity"
            android:exported="false"/>
        <activity
            android:label="App Voice"
            android:name="aio.tts.AppVoiceActivity"
            android:exported="false"/>
        <activity
            android:name="aio.tts.StressActivity"
            android:permission="android.permission.DUMP"
            android:exported="true"
            android:process=":stress"/>
        <receiver
            android:name="aio.tts.TtsTestReceiver"
            android:permission="android.permission.DUMP"
            android:exported="true">
            <intent-filter>
                <action android:name="aio.tts.TEST_SPEAK"/>
                <action android:name="aio.tts.TEST_LIST_VOICES"/>
                <action android:name="aio.tts.TEST_SHAKE"/>
                <action android:name="aio.tts.TEST_DETAILED_LOG"/>
                <action android:name="aio.tts.TEST_SET_VOICE"/>
                <action android:name="aio.tts.TEST_SET_RATE_CAP"/>
            </intent-filter>
        </receiver>
        <service
            android:label="Sweet TTS"
            android:name="aio.tts.Tts"
            android:permission="android.permission.BIND_TEXT_TO_SPEECH"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.intent.action.TTS_SERVICE"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <meta-data
                android:name="android.speech.tts"
                android:resource="@xml/tts_engine"/>
        </service>
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:exported="false"
            android:authorities="aio.tts.androidx-startup">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup"/>
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup"/>
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup"/>
        </provider>
        <uses-library
            android:name="androidx.window.extensions"
            android:required="false"/>
        <uses-library
            android:name="androidx.window.sidecar"
            android:required="false"/>
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:permission="android.permission.DUMP"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE"/>
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE"/>
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE"/>
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
